 (function () {
 	if (!/^(127\.0\.0\.1|localhost|\[::1\])$/.test(location.hostname)) return;
 
+	/* ---------- ① 接管 alert：原生 alert 会冻结全部 JS（报错弹窗后 harness 停摆 ✗） ---------- */
+	let alertBox = null;
+	function showAlertBox(msg) {
+		try {
+			if (!alertBox) {
+				alertBox = document.createElement("div");
+				alertBox.style.cssText =
+					"position:fixed;left:8px;bottom:8px;max-width:46vw;max-height:34vh;overflow:auto;z-index:99999;" +
+					"background:rgba(20,20,20,.92);color:#ffd479;font:12px/1.5 monospace;padding:8px 10px;" +
+					"border:1px solid #a86;border-radius:6px;white-space:pre-wrap";
+				document.body.appendChild(alertBox);
+			}
+			alertBox.textContent = String(msg).slice(0, 2000);
+			alertBox.style.display = "block";
+			clearTimeout(alertBox._t);
+			alertBox._t = setTimeout(() => {
+				if (alertBox) alertBox.style.display = "none";
+			}, 8000);
+		} catch (e) {}
+	}
+	if (typeof window.alert === "function" && !window.__yomiAlertPatched) {
+		window.__yomiAlertPatched = true;
+		window.alert = function (msg) {
+			showAlertBox(msg);
+			appendText(REPORT, "  【页面 alert（已改为非阻塞）】" + String(msg).split("\n").slice(0, 6).join(" | ") + "\n");
+			console.error("[yomi] (alert) " + msg);
+		};
+	}
+
 	const REPORT = "_yomi_auto_report.txt";
 	const ERRLOG = "_yomi_errors.log";
 	const KEY = "_yomi_auto_batch";
@@ -253,9 +282,12 @@ import { lib, game, ui, get, ai, _status } from "noname";
 
 	/* ---------- 阶段 B：开局（轮换武将 + continue_name + directstart） ---------- */
 	async function ensureIngame(st, label) {
+		// 报错后要强制重开（st.forceRestart）→ 跳过「已在局内」的短路
+		const forced = !!st.forceRestart;
+		if (forced) delete st.forceRestart;
 		// ⚠️ 必须排除「本局已结束」：结束后 game.me/game.players 依然存在，
 		//    否则会误判成「还在对局中」→ 直接 return → 停在「战斗失败/重新开始」界面不动 ✗
-		if (ingame() && aliveCount() > 1 && !gameOver()) return true;
+		if (!forced && ingame() && aliveCount() > 1 && !gameOver()) return true;
 		st.reloads = (st.reloads || 0) + 1;
 		if (st.reloads > 5) {
 			await appendText(REPORT, "  ❌ " + label + " 连续 " + (st.reloads - 1) + " 次未进对局，放弃。\n" + window.__yomiSnapshot() + "\n");
@@ -289,8 +321,15 @@ import { lib, game, ui, get, ai, _status } from "noname";
 		let why = "timeout";
 		let lastBeat = 0;
 		const perMatchMax = 9 * 60 * 1000;
+		let errCount = st.errBase;
+		let lastErrCheck = 0;
 		while (Date.now() - mt < perMatchMax) {
 			enableAuto();
+			const nowSec = Math.round((Date.now() - mt) / 1000);
+			if (nowSec - lastErrCheck >= 3) {
+				lastErrCheck = nowSec;
+				errCount = await errLines();
+			}
 			if (ui && ui.continue_game) {
 				why = "ended";
 				break;
@@ -308,6 +347,13 @@ import { lib, game, ui, get, ai, _status } from "noname";
 				lastBeat = el;
 				await appendText(REPORT, "    · 心跳 " + el + "s 存活=" + aliveCount() + " auto=" + (_status ? _status.auto : "?") + " over=" + !!(_status && _status.over) + " imchoosing=" + !!(_status && _status.imchoosing) + " 事件=" + evtChain() + "\n");
 			}
+			// ③ 本局出现报错 → 跳过本局、强制重开（用户要求：出错也继续测其他问题 ✓）
+			//    原生 alert 已被接管为非阻塞，所以这里能继续跑 ✓
+			if (errCount > st.errBase + 1) {
+				await appendText(REPORT, "    ⚠️ 本局出现报错（错误日志增长），跳过本局并重开新局 ✓\n");
+				why = "error-skip";
+				break;
+			}
 			if (!ingame()) {
 				const hit = driveStartMenu(st.hero);
 				if (hit) {
@@ -407,6 +453,8 @@ import { lib, game, ui, get, ai, _status } from "noname";
 			console.log("[自动对局] 全部完成");
 			return;
 		}
+		// 本局是「报错跳过」→ 下一局强制重开（不沿用当前对局状态）
+		if (why === "error-skip" || why === "timeout") st.forceRestart = true;
 		// ⚠️ 不用 game.reloadCurrent()：它会把 continue_name 覆盖成「本局武将」，轮换就失效了
 		await ensureIngame(st, "下一局");
 		running = false;
