+/** 是否是「铁索连环」传导出来的伤害：本次受伤者**不在该牌实际指定的目标里**。
+ *  ⚠️ 本项目自定义取舍（偏离本体）：传导伤害**不再重复吃**【瞄准】【充能】这类加成，
+ *  否则同一张【杀】会让被传导的角色比原目标多挨几点（实测 2 点 → 传导后 4 点）。 */
+function isChainedDamage(event) {
+	const use = parentUseCard(event);
+	if (!use) return false;
+	const targets = use.targets || [];
+	return targets.length > 0 && !targets.includes(event.player);
+}
