+// @ts-nocheck
+/**
+ * 自制游戏卡 · 主题包 4「名场面·梗卡」（包名 `yomi_pack_meme`，56 张归属 8 张）
+ *
+ * 结构依据：`卡牌实现方案.md` §一、§七（勾选 / 单卡禁用）、§八（分包方案）。
+ * 加载链路与「能看到 / 能勾选 / 能单卡禁用」的三项硬条件同 `yomi_pack_sanguo.js` 头部说明：
+ *   ① `export const type = "card"` + `export default {...}`；
+ *   ② 每张卡的 `translate[<卡id>_info]` 必须在（`init/loading.ts:17`，缺则该卡不进 `lib.cardPack`，界面看不到也无法禁用）；
+ *   ③ `list` 正常填写 `[花色, 点数, 卡id]`（`init/loading.ts:40`、`:57`）。
+ * 包名不带 `mode_` 前缀（`cardPackMenu.js:270-272`，否则失去单卡禁用能力）。
+ *
+ * 花色点数依据：本卡在 CSV 中为「无色」，按「花色点数轮转发放」规则发放实体花色与点数 ——
+ *    规则与游标状态见工作区根目录 `花色点数分配记录.md`（全局第 11 位：**黑桃 11**）。
+ *
+ * 本批内容（B 档第一批 18 张中的 1 张）：
+ *   - `yomi_liema_fengbao` 猎马风暴 CSV id=31，「弃置场上所有的坐骑」。
+ *     其余 7 张（不是我害了你 / 一对笑面虎 / 热身 / 这就不奇怪了 / 神行太保陶商之马 /
+ *     死亡是凉爽的夏夜 / 遗失）为 C、D 档，后续批次补入。
+ *
+ * 命名依据：`名称登记表.md`（一律 `yomi_` 前缀）。本包暂无与本体重名的显示名。
+ */
+import { lib, game, ui, get, ai, _status } from "noname";
+
+export const type = "card";
+
+export default {
+	name: "yomi_pack_meme",
+
+	card: {
+		// 猎马风暴：CSV id=31。「弃置场上所有的坐骑。」
+		// 实现说明：坐骑在无名杀里是 subtypes `equip3`（+1 马）与 `equip4`（-1 马），
+		// 遍历全场收集后由使用者一次性弃置（discard 会自行定位每张牌所在区域）。
+		yomi_liema_fengbao: {
+			type: "trick",
+			enable: true,
+			// 本牌不指定目标，使用后直接对全场生效（参考本体「无懈可击」等牌的 notarget 写法）
+			notarget: true,
+			async content(event, trigger, player) {
+				const cards = [];
+				for (const target of game.filterPlayer()) {
+					cards.addArray(
+						target.getCards("e", card => {
+							const subtype = get.subtype(card);
+							return subtype === "equip3" || subtype === "equip4";
+						})
+					);
+				}
+				if (cards.length) {
+					await player.discard(cards);
+				}
+			},
+		},
+	},
+
+	skill: {},
+
+	translate: {
+		yomi_pack_meme: "名场面·梗卡", // → lib.translate["yomi_pack_meme_card_config"]
+
+		yomi_liema_fengbao: "猎马风暴",
+		yomi_liema_fengbao_bg: "猎",
+		yomi_liema_fengbao_info: "出牌阶段，对所有角色使用。弃置场上所有的坐骑。",
+	},
+
+	// 勾选本包后，下列牌进入牌堆。
+	list: [
+		["spade", 11, "yomi_liema_fengbao"], // 黑桃 J(11)（无色卡轮转全局第 11 位）
+	],
+};
