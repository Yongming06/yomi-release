+// @ts-nocheck
+/**
+ * 自制游戏卡 · 主题包 5「原创核心·无色牌池」（包名 `yomi_pack_core`，56 张归属 16 张）
+ *
+ * 结构依据：`卡牌实现方案.md` §一、§七（勾选 / 单卡禁用）、§八（分包方案）。
+ * 加载链路与「能看到 / 能勾选 / 能单卡禁用」的三项硬条件同 `yomi_pack_sanguo.js` 头部说明：
+ *   ① `export const type = "card"` + `export default {...}`；
+ *   ② 每张卡的 `translate[<卡id>_info]` 必须在（`init/loading.ts:17`，缺则该卡不进 `lib.cardPack`，界面看不到也无法禁用）；
+ *   ③ `list` 正常填写 `[花色, 点数, 卡id]`（`init/loading.ts:40`、`:57`）。
+ * 包名不带 `mode_` 前缀（`cardPackMenu.js:270-272`，否则失去单卡禁用能力）。
+ *
+ * 卡包可以带 `skill` 段（`init/loading.ts:74-99` 的 `default` 分支会写进 `lib.skill` / `lib.translate`），
+ * 本包用它承载：装备牌技能（隼鳞 / 光刃）、各类临时增益载体（泥浆铠甲 / 当头棒喝 / 贪婪 / 伪造账单）。
+ *
+ * 花色点数依据：本包无色卡按「花色点数轮转发放」规则发放实体花色与点数 ——
+ *    规则与游标状态见工作区根目录 `花色点数分配记录.md`（全局第 5、6、8、10、13、14、15、16、17、18、19 位）。
+ *    本包不再使用引擎的 `"none"` 无色。
+ *
+ * 本包内容（累计 15 张）：
+ *   A 档（第一批）：
+ *   - `yomi_mingsha_xianjing` 鸣沙陷阱 CSV id=34；`yomi_nijiang_kaijia` 泥浆铠甲 CSV id=35；`yomi_huoyunche` 火云车 CSV id=40；
+ *   B 档（第二批，本批新增）：
+ *   - `yomi_huanhunxianyao`   还魂仙药   CSV id=1（重铸 + 体力上限复原）
+ *   - `yomi_huixing`          彗星       CSV id=2 与 id=54（同 id 两张实体牌，list 各一条）
+ *   - `yomi_kuangzhanshizhihun` 狂战士之魂 CSV id=3（摸牌链式伤害）
+ *   - `yomi_huanma_fengbo`    换马风波   CSV id=23（全场坐骑重铸）
+ *   - `yomi_fengyin`          风隐       CSV id=26（跳过双方下个回合）
+ *   - `yomi_bianfu`           蝙蝠       CSV id=36（吸血伤害）
+ *   - `yomi_tanlan`           贪婪       CSV id=37（本回合牌均吸血）
+ *   - `yomi_weizao_zhangdan`  伪造账单   CSV id=39（回复改为流失）⚠️ 见卡内注释的实现偏差
+ *   - `yomi_sunlin`           隼鳞       CSV id=41（防具：伤害类型记录）
+ *   - `yomi_guangren`         光刃       CSV id=42（武器：每回合首张属性伤害 +1）
+ *   - `yomi_shengri_danggao`  生日蛋糕   CSV id=46（判定区操作）
+ *
+ * ⚠️ 本批含若干**实现偏差**（引擎无对应机制或需事件改写），均已在对应卡片的注释中用 ⚠️ 标出，
+ *    并在 `PROJECT_REPORT.md` 的「已知问题 / 待办」中登记，待实机验证后再精修。
+ *
+ * 命名依据：`名称登记表.md`（一律 `yomi_` 前缀）。本包显示名与本体均不重名，不加「（改）」。
+ */
+import { lib, game, ui, get, ai, _status } from "noname";
+
+export const type = "card";
+
+/** 隼鳞：读取记录在**装备牌实例**上的伤害类型（卸装即失效） */
+function sunlinRecorded(player) {
+	const equip = player.getEquip("yomi_sunlin");
+	return equip && equip.storage ? equip.storage.yomi_sunlin_type : null;
+}
+
+/** 隼鳞：判定一次伤害事件的「类型」—— 基本 / 锦囊 / 技能 / 其它 */
+function damageKind(event) {
+	if (event.card) {
+		const cardType = get.type(event.card);
+		if (cardType === "basic") {
+			return "basic";
+		}
+		if (cardType === "trick" || cardType === "delay") {
+			return "trick";
+		}
+		return "other";
+	}
+	if (event.skill) {
+		return "skill";
+	}
+	return "other";
+}
+
+export default {
+	name: "yomi_pack_core",
+
+	card: {
+		// 还魂仙药：CSV id=1。「重铸。若你的当前体力上限低于武将初始体力上限，则使其变回初始体力上限。」
+		// ⚠️ 实现偏差：引擎的「重铸」只做「弃置该牌 + 摸一张牌」，**不经过 content**，
+		//     因此本实现让它同时可以正常使用（出牌阶段对自己使用）来触发上限复原效果。
+		yomi_huanhunxianyao: {
+			type: "trick",
+			enable: true,
+			recastable: true, // 可在手牌区重铸（library/index.js:10969）
+			toself: true,
+			selectTarget: -1,
+			filterTarget(card, player, target) {
+				return target === player;
+			},
+			async content(event, trigger, player) {
+				// 初始体力上限 = 该武将定义里的第 3 项（lib.character[name][2]）
+				const name = player.name1 || player.name;
+				const info = lib.character[name];
+				const initHp = info ? info[2] : player.maxHp;
+				if (typeof initHp === "number" && player.maxHp < initHp) {
+					await player.gainMaxHp(initHp - player.maxHp);
+				}
+			},
+		},
+
+		// 彗星：CSV id=2（与 id=54 同效果、同 id，两张实体牌）。「使你的体力流失至0，对一名其它角色造成
+		// 等同于流失值+1点伤害，其可弃置若干张牌，每弃置两张抵消1点伤害。（伤害上限为5）」
+		yomi_huixing: {
+			type: "trick",
+			enable: true,
+			selectTarget: 1,
+			filterTarget: lib.filter.notMe,
+			async content(event, trigger, player) {
+				const target = event.target;
+				const lose = player.hp; // 流失值 = 当前体力（把体力流失至 0）
+				// 卡面：「本牌造成濒死时，优先结算对方的濒死」——
+				// 做法：先用 player.nodying 压住**自己**的濒死结算（引擎的 dying 流程会检查该标记，
+				// 见 content.ts:12450），让自己的体力归零但不立刻进入濒死；接着正常对目标造成伤害
+				// （目标若濒死，按引擎默认流程结算）；最后再补触发自己的濒死。
+				if (lose > 0) {
+					player.nodying = true;
+					await player.loseHp(lose);
+					delete player.nodying;
+				}
+				let num = Math.min(5, lose + 1);
+				// 目标可弃置若干张牌，每两张抵消 1 点
+				while (num > 0 && target.countCards("he") >= 2) {
+					const result = await target
+						.chooseToDiscard({
+							position: "he",
+							selectCard: [2, 2],
+							prompt: `彗星：弃置2张牌以抵消1点伤害（剩余${num}点，可取消）`,
+						})
+						.forResult();
+					if (!result.bool) {
+						break;
+					}
+					num--;
+				}
+				if (num > 0) {
+					await target.damage(num, player);
+				}
+				// 对方的濒死已经结算完毕，这时才轮到自己进入濒死
+				if (player.hp <= 0 && player.isAlive() && !player.isOut()) {
+					await player.dying();
+				}
+			},
+			ai: {
+				tag: { damage: 1 },
+				result: {
+					// AI：本牌代价极高（自己体力流失至 0），只在「打得死对方、且自己大概率救得回来」时才用。
+					target(player, target) {
+						if (get.damageEffect(target, player, player) <= 0) {
+							return -1;
+						}
+						const damage = Math.min(5, player.hp + 1);
+						// 打不死就别拿命去换
+						if (damage < target.hp + (target.hujia || 0)) {
+							return -1;
+						}
+						// 自己血太少、手上又没【桃】时不冒险
+						const hasTao = player.countCards("h", card => get.name(card) === "tao") > 0;
+						if (player.hp <= 1 && !hasTao) {
+							return -1;
+						}
+						return 1;
+					},
+				},
+			},
+		},
+
+		// 狂战士之魂：CSV id=3。「摸一张牌并选择一个目标，若摸到的牌为黑色，弃置其并对目标造成1点伤害，
+		// 重复此操作。那之后，你弃一张牌。」
+		// 注：原牌面还有「此过程中，摸牌相关技能改为摸完所有牌后结算」一句 ——
+		// 用户已确认**线上不需要**这条限制（它只是线下与技能互动难以结算时的权宜），故不实现。
+		yomi_kuangzhanshizhihun: {
+			type: "trick",
+			enable: true,
+			selectTarget: 1,
+			filterTarget: lib.filter.notMe,
+			async content(event, trigger, player) {
+				const target = event.target;
+				// 循环：摸 1 张 → 黑色则弃置并造成 1 点伤害 → 回到开头继续摸；直到摸到非黑色为止。
+				// 取牌用 `await next; next.cards`（本体标准写法，见 clan/skill.js:5601、sp2/skill.js:16360），
+				// 比 `.forResult()` 更直接，避免个别引擎分支下取不到 cards 而提前跳出循环。
+				// guard 只是防御性上限，防止极端情况下的无限循环（正常最多几十次）。
+				let guard = 0;
+				while (guard++ < 60) {
+					const next = player.draw(1);
+					await next;
+					// ★ 取「摸到的牌」必须读 `event.result.cards` —— `draw` 的 content 把结果写在这里
+					//   （`content.ts:10897` `event.result = { bool: true, cards }`）。
+					//   `event.cards` 恒为 undefined → 之前写 `next.cards` 导致 cards 永远为空、直接 break，
+					//   于是「即使摸出黑牌也无法造成伤害」。
+					const cards = (next.result && next.result.cards) || next.cards || [];
+					if (!cards.length) {
+						break;
+					}
+					const card = cards[0];
+					const isBlack = get.color(card) === "black";
+					game.log(player, "狂战士之魂：摸到", card, isBlack ? "（黑色，继续）" : "（非黑色，停止）");
+					if (!isBlack) {
+						break;
+					}
+					await player.discard(cards);
+					await target.damage(1, player);
+				}
+				// 所有重复结束之后，你弃一张牌
+				if (player.countCards("he") > 0) {
+					await player
+						.chooseToDiscard({
+							position: "he",
+							selectCard: [1, 1],
+							forced: true,
+							prompt: "狂战士之魂：弃置1张牌",
+						})
+						.forResult();
+				}
+			},
+			ai: {
+				tag: { damage: 1 },
+				result: {
+					// AI：这是「弃牌换伤害」的牌，只对敌方角色使用
+					target(player, target) {
+						return get.damageEffect(target, player, player);
+					},
+				},
+			},
+		},
+
+		// 换马风波：CSV id=23。「重铸。为场上所有角色将其坐骑重铸。」
+		// 重铸语义 = 弃置该牌并摸一张，故对每匹坐骑执行「弃置 + 摸一」。
+		yomi_huanma_fengbo: {
+			type: "trick",
+			enable: true,
+			recastable: true,
+			notarget: true,
+			async content(event, trigger, player) {
+				for (const target of game.filterPlayer()) {
+					const horses = target.getCards("e", card => {
+						const subtype = get.subtype(card);
+						return subtype === "equip3" || subtype === "equip4";
+					});
+					for (const horse of horses) {
+						await target.discard(horse);
+						await target.draw(1);
+					}
+				}
+			},
+		},
+
+		// 风隐：CSV id=26。「重铸。弃一张手牌，跳过你与一名其它角色的下一个回合。」
+		// ⚠️ 「跳过下一个回合」用 `player.skip("phase")` 实现（本体用法见 mode/versus.js:8345），
+		//     实际生效时机（在 phaseBegin 里 skip 是否来得及）**待实机验证**。
+		yomi_fengyin: {
+			type: "trick",
+			enable: true,
+			recastable: true,
+			selectTarget: 1,
+			filterTarget: lib.filter.notMe,
+			async content(event, trigger, player) {
+				const target = event.target;
+				// 代价：弃一张手牌
+				const discardResult = await player
+					.chooseToDiscard({
+						position: "h",
+						selectCard: [1, 1],
+						forced: true,
+						prompt: "风隐：弃置1张手牌",
+					})
+					.forResult();
+				if (!discardResult.bool) {
+					return;
+				}
+				// 你与该角色各挂一个「跳过下个回合」标记
+				player.addSkill("yomi_fengyin_skip");
+				target.addSkill("yomi_fengyin_skip");
+			},
+			ai: {
+				result: {
+					// AI：本牌会让「你与目标」都跳过下个回合，只对敌方角色使用才划算
+					target(player, target) {
+						return get.attitude(player, target) < 0 ? 1 : -1;
+					},
+				},
+			},
+		},
+
+		// 蝙蝠：CSV id=36。「吸血。弃一张牌，对一名其它角色造成1点伤害。其可打出一张【闪】以抵消此伤害。」
+		yomi_bianfu: {
+			type: "trick",
+			enable: true,
+			selectTarget: 1,
+			filterTarget: lib.filter.notMe,
+			async content(event, trigger, player) {
+				const target = event.target;
+				// 代价：弃一张牌
+				const discardResult = await player
+					.chooseToDiscard({
+						position: "he",
+						selectCard: [1, 1],
+						forced: true,
+						prompt: "蝙蝠：弃置1张牌",
+					})
+					.forResult();
+				if (!discardResult.bool) {
+					return;
+				}
+				// 目标可打出一张【闪】抵消
+				const next = target.chooseToRespond();
+				next.set("filterCard", (card, target2) => get.name(card) === "shan" && lib.filter.cardRespondable(card, target2));
+				next.set("prompt", "蝙蝠：请打出一张【闪】，否则受到1点伤害");
+				next.set("ai", card => (get.event().toRespond ? get.order(card) : -1));
+				next.set("toRespond", 1 >= target.hp + (player.hasSkillTag("jueqing", false, target) ? 0 : target.hujia) || get.damageEffect(target, player, target) < 0);
+				const result = await next.forResult();
+				if (!result.bool) {
+					// 吸血（本项目自定义关键词）：造成伤害后为你回复**等量**体力 ——
+					// 伤害因其他效果增减时，回复量随之变化（见《卡牌作业手册》「吸血」条）。
+					const damageEvent = target.damage(1, player);
+					await damageEvent;
+					await player.recover(damageEvent.num || 1);
+				}
+			},
+			ai: {
+				tag: { damage: 1 },
+				result: {
+					// AI：只对敌方角色使用（造成伤害 + 自己吸血，对敌人是负收益）
+					target(player, target) {
+						return get.damageEffect(target, player, player);
+					},
+				},
+			},
+		},
+
+		// 贪婪：CSV id=37。「在本回合中，使你之后使用的牌均具有吸血。」
+		yomi_tanlan: {
+			type: "trick",
+			enable: true,
+			toself: true,
+			selectTarget: -1,
+			filterTarget(card, player, target) {
+				return target === player;
+			},
+			async content(event, trigger, player) {
+				player.addTempSkill("yomi_tanlan_buff", { player: "phaseJieshuBegin" });
+			},
+		},
+
+		// 伪造账单：CSV id=39。「有角色回复体力时可以使用，你弃等量张牌，以使其的回复改为流失。」
+		// 实现：**完全响应式** —— 这张牌不能在出牌阶段主动使用（enable: false），
+		// 而是由一个**全局观察者技能** `yomi_weizao_zhangdan_watch` 在「有角色回复体力时」
+		// 检查持有者手牌并给出使用机会（思路参照【无懈可击】standard.js:3096 的响应窗口）。
+		// 使用效果：弃置与该角色回复量**等量**的牌 → 撤销这次回复 → 令其流失等量体力。
+		// 注：该观察者技能在**文件末尾**被注册进 lib.skill.global（卡包 skill 段不会自动加入全局）。
+		yomi_weizao_zhangdan: {
+			type: "trick",
+			enable: false, // 只能通过观察者技能在「有角色回复体力时」触发，不能主动使用
+			async content(event, trigger, player) {
+				// 真正的效果在观察者技能里；这里留空以作保险
+				return;
+			},
+		},
+
