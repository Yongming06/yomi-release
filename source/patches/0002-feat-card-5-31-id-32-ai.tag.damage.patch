+// @ts-nocheck
+/**
+ * 自制游戏卡 · 主题包 3「机变·应对与奥秘」（包名 `yomi_pack_reactive`，56 张归属 9 张）
+ *
+ * 结构依据：`卡牌实现方案.md` §一、§七（勾选 / 单卡禁用）、§八（分包方案）。
+ * 加载链路与「能看到 / 能勾选 / 能单卡禁用」的三项硬条件同 `yomi_pack_sanguo.js` 头部说明：
+ *   ① `export const type = "card"` + `export default {...}`；
+ *   ② 每张卡的 `translate[<卡id>_info]` 必须在（`init/loading.ts:17`，缺则该卡不进 `lib.cardPack`，界面看不到也无法禁用）；
+ *   ③ `list` 正常填写 `[花色, 点数, 卡id]`（`init/loading.ts:40`、`:57`）。
+ * 包名不带 `mode_` 前缀（`cardPackMenu.js:270-272`，否则失去单卡禁用能力）。
+ *
+ * 花色点数：本包无色卡按轮转规则发放（规则与游标见工作区根目录 `花色点数分配记录.md`）；
+ *   有花色点数的卡（欢愉＊笑点 方块 Q）沿用 CSV 原值、不消耗游标。
+ *
+ * ─────────────────────────────────────────────────────────────────────────
+ * 【奥秘】子系统（本项目自定义机制，用户定义）
+ * 1. 奥秘牌在**自己的出牌阶段**使用，使用后**其他人看不到你用了什么**（暗置）；
+ * 2. 持有者的武将牌左上角出现一个「**奥**」标记，多张时标记右下角显示数字；
+ * 3. 达成该奥秘的发动条件时**强制发动**，然后才结算牌面写的后续效果；
+ * 4. **发动的那一刻**奥秘牌才进入弃牌堆，此时所有人才看得到；
+ * 5. 奥秘牌带**特殊标记**（`card.storage.yomi_aomi = true`），供后续"针对奥秘牌"的牌检测。
+ *
+ * 实现要点：
+ *  · 牌去向（**暗置**）：奥秘牌**不能通过"使用牌"生效** —— 卡牌走 useCard 流程时，牌必定被
+ *    `cardsDiscard` 送进弃牌堆（弃牌堆公开 = 暴露）。因此改由卡包级技能 `yomi_aomi_use`：
+ *    技能上写 `discard: false` / `lose: false`（**只有技能上的这两个字段有效**，卡定义上无效），
+ *    再在 content 里 `player.lose(card, ui.special)` 把牌移入**特殊区** →
+ *    牌不在手牌 / 装备 / 判定区，其他人看不到，也不在弃牌堆；
+ *  · 标记：技能 `yomi_mark_aomi` 的 `marktext: "奥"`（本体同类写法见 character/bingshi/skill.js:3178 的「田」）；
+ *  · 发动：共用函数 `aomiActivate()` 负责「扣标记 → 移除观察者 → `game.cardsDiscard` 让牌进弃牌堆」。
+ * ─────────────────────────────────────────────────────────────────────────
+ *
+ * 本包内容（累计 3 张）：
+ *   B 档：`yomi_huanyu_xiaodian` 欢愉＊笑点 CSV id=70（神谕：本回合下一张伤害牌乘「欢愉乘区」）
+ *   C 档·奥秘：`yomi_mingku` 命苦啊 CSV id=4、`yomi_houfa_zhiren` 后发制人 CSV id=38
+ *
+ * 命名依据：`名称登记表.md`（一律 `yomi_` 前缀）。本包暂无与本体重名的显示名。
+ */
+import { lib, game, ui, get, ai, _status } from "noname";
+
+export const type = "card";
+
+/**
+ * 奥秘发动：把某个已暗置的奥秘牌「翻开并送进弃牌堆」，并清理它的标记与观察者技能。
+ * @param {*} player 奥秘的拥有者
+ * @param {string} cardName 奥秘牌的卡 id（如 "yomi_mingku"）
+ * @returns {boolean} 是否真的发动了（找不到牌则返回 false）
+ */
+function aomiActivate(player, cardName) {
+	const all = player.storage.yomi_aomi_cards || [];
+	const cards = all.filter(card => card.name === cardName);
+	if (!cards.length) {
+		return false;
+	}
+	// 从暗置记录里取出
+	player.storage.yomi_aomi_cards = all.filter(card => card.name !== cardName);
+	sizeCheck(player);
+	// 扣掉一个「奥」标记
+	player.removeMark("yomi_mark_aomi", cards.length);
+	// 移除该奥秘的观察者技能
+	player.removeSkill(`${cardName}_watch`);
+	// 此刻才进入弃牌堆 —— 所有玩家都能看到这张奥秘牌
+	game.cardsDiscard(cards);
+	game.log(player, "翻开了奥秘", get.translation(cardName));
+	return true;
+}
+
+/** 记录为空时清理 storage 键（避免残留空数组） */
+function sizeCheck(player) {
+	if ((player.storage.yomi_aomi_cards || []).length === 0) {
+		delete player.storage.yomi_aomi_cards;
+	}
+}
+
+/**
+ * 暗置一张奥秘牌：打上「奥秘」特殊标记、计入暗置记录、点亮「奥」标记、挂上该奥秘的观察者技能。
+ * ⚠️ 注意：奥秘**不能**通过「使用牌」的流程暗置 —— 卡牌走 useCard 流程时，牌**必定**会被
+ *    `cardsDiscard` 送进弃牌堆（弃牌堆是公开的，等于暴露）。
+ *    正确做法是用一个**技能**来消耗这张手牌（技能上的 `discard: false` / `lose: false` 才有效），
+ *    再在技能 content 里 `player.lose(card, ui.special)` 把它移入特殊区。
+ * @param {*} player 奥秘的持有者
+ * @param {*} card 要暗置的**实体牌**
+ */
+function aomiRegister(player, card) {
+	const cardName = card.name;
+	if (!card.storage) {
+		card.storage = {};
+	}
+	// ★ 特殊标记：标记这张**实体牌**是"奥秘牌"，供后续"针对奥秘"的效果检测
+	card.storage.yomi_aomi = true;
+	card.storage.yomi_aomi_name = cardName;
+	player.storage.yomi_aomi_cards = (player.storage.yomi_aomi_cards || []).concat([card]);
+	player.addMark("yomi_mark_aomi", 1);
+	player.addSkill(`${cardName}_watch`);
+	game.log(player, "暗置了一个奥秘");
+}
+
+/**
+ * 判断一次 `useCard` 是否被【无懈可击】抵消。
+ *
+ * 原理：无懈结算时会对「牌的**结算事件**」调用 `neutralize()`（`gameEvent.ts:693`），
+ *   给它打上 `_neutralized`；而这个结算事件的**父事件**正是本次 `useCard`。
+ *   本体的同类判定见 `character/newjiang/skill.js` 的「蹙国」：
+ *     game.getGlobalHistory("everything", evt => evt._neutralized && evt.getParent().name == "useCard")
+ *
+ * @param {*} useEvent `player.useCard()` 返回的 useCard 事件
+ * @returns {boolean} 是否被无懈（事件缺失时视为未成功使用，同样返回 true）
+ */
+function wasNeutralized(useEvent) {
+	if (!useEvent) {
+		return true;
+	}
+	// 兼容个别分支直接在 useCard 事件上打标记的情况
+	if (useEvent._neutralized) {
+		return true;
+	}
+	// ① 结算事件（useCard 的直接子事件，如「yomi_aomi」的牌结算事件）被 neutralize
+	if ((useEvent.childEvents || []).some(evt => evt._neutralized)) {
+		return true;
+	}
+	// ② 同上，但通过全局历史回溯（与本体「蹙国」同思路），兼容子事件未被记录的情况
+	return game.getGlobalHistory("everything", evt => evt._neutralized && evt.getParent() === useEvent).length > 0;
+}
+
+/* ─────────────────────────────────────────────────────────────────────────
+ * 【应对】子系统（本项目自定义机制，用户定义）
+ * 1. 应对牌只能在**自己的出牌阶段**暗置（与【奥秘】同款：走标准 useCard 流程，可被无懈）；
+ * 2. 暗置后其他人只能看到「有一张应对牌」+ **花色**，看不到是哪张；
+ * 3. **一名角色同时最多暗置 1 张**；
+ * 4. 只要挂着就**持续检测**：其他角色以你为**唯一目标**使用一张牌时，翻开它；
+ * 5. 按「对方这张牌是伤害类 / 非伤害类」分流触发应对效果；效果结算完后该牌**才**进弃牌堆；
+ * 6. 结算后若手里还有应对牌，可以**立即再暗置一张**。
+ * 实现思路基本镜像【奥秘】：卡包级全局技能负责暗置、标记技能负责显示、玩家私有观察者负责触发。
+ * ───────────────────────────────────────────────────────────────────────── */
+
+/** 这张实体牌是不是「应对牌」 */
+function isRespondCard(card) {
+	return !!(card && card.name && lib.card[card.name]?.yomi_respond);
+}
+
+/** 暗置一张应对牌：打标记 → 记录 → 亮「应」标记 → 挂持续检测器 */
+function respondRegister(player, card) {
+	if (!card.storage) {
+		card.storage = {};
+	}
+	card.storage.yomi_respond = true;
+	card.storage.yomi_respond_name = card.name;
+	// 上限 1 张：由 yomi_respond_use.filter 保证，这里直接覆盖式记录
+	player.storage.yomi_respond_cards = [card];
+	player.addMark("yomi_mark_respond", 1);
+	player.addSkill("yomi_respond_watch");
+	game.log(player, "暗置了一张应对牌");
+}
+
+/** 翻开（公开）一张应对牌 —— ⚠️ 此刻**还不进弃牌堆**，要等应对效果结算完（用户设计） */
+function respondReveal(player, card) {
+	player.popup(card.name);
+	game.log(player, "翻开了应对牌", card);
+}
+
+/** 应对结算完毕：应对牌进弃牌堆 + 清理「应」标记 / 记录 / 检测器 */
+function respondFinish(player, card) {
+	// ★ v0.27：**彻底重置**，不再用 filter 局部删除。
+	//   旧写法在「链中重挂」时会把新牌的记录误删/误留（记录留着、标记与观察者已没）
+	//   → 表现为「应对按钮凭空消失、再也不能暗置（已踩）」。
+	// ⚠ 只清理「当前挂载的就是这张牌」的情况；若记录已被新牌覆盖，则不动新牌的状态。
+	const current = (player.storage.yomi_respond_cards || [])[0];
+	if (current && current !== card) {
+		game.cardsDiscard([card]);
+		game.log(player, "的应对牌进入弃牌堆");
+		return;
+	}
+	delete player.storage.yomi_respond_cards;
+	const markNum = player.countMark("yomi_mark_respond");
+	if (markNum > 0) {
+		player.removeMark("yomi_mark_respond", markNum);
+	}
+	player.removeSkill("yomi_respond_watch");
+	game.cardsDiscard([card]);
+	game.log(player, "的应对牌进入弃牌堆");
+}
+
+/**
+ * 暗置流程（出牌阶段的入口 与 结算后的「立即再暗置」共用）。
+ * 与【奥秘】完全同款：走标准 `useCard` → 引擎在 `useCardToBegin` 开【无懈可击】窗口（含使用者自己）。
