+				if (num > 0) {
+					await target.damage(num, player);
+				}
+			},
+			ai: {
+				tag: { damage: 1 },
+				result: {
+					// AI：这是「弃光自己的手牌换伤害」的高代价牌，只对敌方角色使用
+					target(player, target) {
+						return get.damageEffect(target, player, player);
+					},
+				},
+			},
+		},
+
+		// 手牌抹杀：CSV id=22。选择一名其它角色，你与其弃置所有手牌，然后各摸等同于自己弃置数量的牌。
+		yomi_shoupai_mosha: {
+			type: "trick",
+			enable: true,
+			selectTarget: 1,
+			filterTarget: lib.filter.notMe,
+			async content(event, trigger, player) {
+				const target = event.target;
+				const myCards = player.getCards("h");
+				const targetCards = target.getCards("h");
+				// 第一步：双方各自弃光手牌
+				if (myCards.length) {
+					await player.discard(myCards);
+				}
+				if (targetCards.length) {
+					await target.discard(targetCards);
+				}
+				// 第二步：各摸等同于自己弃置数量的牌
+				if (myCards.length) {
+					await player.draw(myCards.length);
+				}
+				if (targetCards.length) {
+					await target.draw(targetCards.length);
+				}
+			},
+		},
+	},
+
+	skill: {
+		// 索瑞森大帝之锤的装备技能：每个玩家的回合结束时，你可使其额外摸一张牌。
+		// forced: true —— 让「是否发动本技能」这一层不再单独询问，玩家只需点一次 content 里的确认框。
+		yomi_suoruisendadi_chui_skill: {
+			forced: true,
+			charlotte: true,
+			trigger: { global: "phaseEnd" },
+			filter(event, player) {
+				return !!event.player;
+			},
+			async content(event, trigger, player) {
+				const target = trigger.player;
+				const result = await player
+					.chooseBool(`索瑞森大帝之锤：是否令${get.translation(target)}额外摸一张牌？`)
+					.set("ai", () => {
+						// AI 判断：摸一张牌对绝大多数角色都是正面收益，所以**只给自己和队友**，
+						// 绝不给敌方角色摸牌（`get.attitude > 0` 即友方；自己单独判一次）。
+						return target === player || get.attitude(player, target) > 0;
+					})
+					.forResult();
+				if (result.bool) {
+					await target.draw(1);
+				}
+			},
+		},
+	},
+
+	translate: {
+		yomi_pack_crossover: "跨界联动·异界来客", // → lib.translate["yomi_pack_crossover_card_config"]
+
+		yomi_suoruisendadi_chui: "索瑞森大帝之锤",
+		yomi_suoruisendadi_chui_bg: "锤",
+		yomi_suoruisendadi_chui_info: "攻击范围1。每个玩家的回合结束时，你可以令其额外摸一张牌。",
+		yomi_suoruisendadi_chui_skill: "索瑞森大帝之锤",
+		yomi_suoruisendadi_chui_skill_info: "每个玩家的回合结束时，你可以令其额外摸一张牌。",
+
+		yomi_monengbao: "魔能爆",
+		yomi_monengbao_bg: "爆",
+		yomi_monengbao_info:
+			"出牌阶段，对一名其他角色使用。你弃置所有手牌，每弃置两张对其造成1点伤害（至多5点）；其可以打出任意张牌响应，每张抵消1点伤害。",
+
+		yomi_shoupai_mosha: "手牌抹杀",
+		yomi_shoupai_mosha_bg: "抹",
+		yomi_shoupai_mosha_info: "出牌阶段，对一名其他角色使用。你与其弃置所有手牌，然后各摸等同于各自弃置数量的牌。",
+	},
+
+	// 勾选本包后，下列牌进入牌堆。
+	list: [
+		["spade", 1, "yomi_suoruisendadi_chui"], // 黑桃 A(1)（CSV 原值）
+		["club", 12, "yomi_monengbao"], // 梅花 Q(12)（无色卡轮转全局第 12 位）
+		["heart", 1, "yomi_shoupai_mosha"], // 红桃 A（无色卡轮转全局第 1 位，游标已推进）
+	],
+};
