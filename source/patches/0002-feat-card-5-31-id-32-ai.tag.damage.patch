+				// 目标可打出任意张牌响应，每张抵消 1 点（写法仿【南蛮入侵】standard.js:1325-1330 与鸣沙陷阱）
+				while (num > 0) {
+					const next = target.chooseToRespond();
+					next.set("filterCard", (card, target2) => lib.filter.cardRespondable(card, target2));
+					next.set("prompt", `魔能爆：请打出一张牌抵消1点伤害（剩余${num}点，可随时停止）`);
