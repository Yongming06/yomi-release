+	//   表现为"有角色回复体力时根本不弹询问框"。
+	if (typeof game.addGlobalSkill === "function") {
+		game.addGlobalSkill(name);
+		return;
+	}
+	// 兜底：老引擎没有该 API 时，至少把技能名挂进 global
+	const g = lib.skill.global;
+	if (g && typeof g.add === "function") {
+		g.add(name);
+	} else if (Array.isArray(g) && !g.includes(name)) {
+		g.push(name);
+	}
+}
