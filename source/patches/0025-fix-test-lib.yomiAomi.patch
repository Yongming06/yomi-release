diff --git a/apps/core/card/yomi_pack_reactive.js b/apps/core/card/yomi_pack_reactive.js
index cdb03cd..d6f7721 100644
--- a/apps/core/card/yomi_pack_reactive.js
+++ b/apps/core/card/yomi_pack_reactive.js
@@ -430,6 +430,18 @@ lib.yomiRespond = {
 	reveal: respondReveal,
 };
 
+/**
+ * 【奥秘】同样对武将包暴露一套最小 API（2026-10-08）：
+ *   测试/调试需要「把某张奥秘牌直接暗置到某个角色身上」的能力，
+ *   而 aomiRegister / aomiActivate 是卡包内的模块级私有函数。
+ * 属性名固定为 `lib.yomiAomi`，缺失时调用方应优雅失败并打日志。
+ */
+lib.yomiAomi = {
+	isAomiCard: card => !!(card && card.name && lib.card[card.name]?.yomi_aomi),
+	register: aomiRegister,
+	activate: aomiActivate,
+};
+
 export default {
 	name: "yomi_pack_reactive",
 	// 联机（connect）模式下允许使用本包：引擎对没有 connect 的包会把技能架空（loading.ts:70/:198）
