diff --git a/apps/core/_yomi_devtools.js b/apps/core/_yomi_devtools.js
index 3196271..33e0df4 100644
--- a/apps/core/_yomi_devtools.js
+++ b/apps/core/_yomi_devtools.js
@@ -167,17 +167,30 @@ import { lib, game, ui, get, ai, _status } from "noname";
 	}
 
 	/* ---------- 我们包里的武将（轮换用） ---------- */
+	function ourPackKeys() {
+		const keys = [];
+		try {
+			for (const k of Object.keys(lib.characterPack || {})) {
+				if (/yomi/i.test(k)) keys.push(k);
+			}
+		} catch (e) {}
+		return keys;
+	}
 	function ourHeroes() {
 		const out = [];
 		try {
-			for (const pack of OUR_PACKS) {
+			// 先按固定包名，再扫描所有含 yomi 的包（实机反馈：固定包名曾一个都没命中）
+			const keys = OUR_PACKS.concat(ourPackKeys().filter(k => !OUR_PACKS.includes(k)));
+			for (const pack of keys) {
 				const p = lib.characterPack && lib.characterPack[pack];
 				if (!p) continue;
 				let list;
 				if (p.character) list = Object.keys(p.character);
 				else if (Array.isArray(p)) list = p;
 				else list = Object.keys(p);
-				for (const id of list) if (lib.character && lib.character[id]) out.push(id);
+				for (const id of list) {
+					if (lib.character && lib.character[id] && !out.includes(id)) out.push(id);
+				}
 			}
 		} catch (e) {}
 		return out;
@@ -221,7 +234,9 @@ import { lib, game, ui, get, ai, _status } from "noname";
 
 	/* ---------- 阶段 B：开局（轮换武将 + continue_name + directstart） ---------- */
 	async function ensureIngame(st, label) {
-		if (ingame() && aliveCount() > 1) return true;
+		// ⚠️ 必须排除「本局已结束」：结束后 game.me/game.players 依然存在，
+		//    否则会误判成「还在对局中」→ 直接 return → 停在「战斗失败/重新开始」界面不动 ✗
+		if (ingame() && aliveCount() > 1 && !gameOver()) return true;
 		st.reloads = (st.reloads || 0) + 1;
 		if (st.reloads > 5) {
 			await appendText(REPORT, "  ❌ " + label + " 连续 " + (st.reloads - 1) + " 次未进对局，放弃。\n" + window.__yomiSnapshot() + "\n");
@@ -272,7 +287,7 @@ import { lib, game, ui, get, ai, _status } from "noname";
 			const el = Math.round((Date.now() - mt) / 1000);
 			if (el - lastBeat >= 30) {
 				lastBeat = el;
-				await appendText(REPORT, "    · 心跳 " + el + "s 存活=" + aliveCount() + " auto=" + (_status ? _status.auto : "?") + " imchoosing=" + !!(_status && _status.imchoosing) + " 事件=" + evtChain() + "\n");
+				await appendText(REPORT, "    · 心跳 " + el + "s 存活=" + aliveCount() + " auto=" + (_status ? _status.auto : "?") + " over=" + !!(_status && _status.over) + " imchoosing=" + !!(_status && _status.imchoosing) + " 事件=" + evtChain() + "\n");
 			}
 			if (!ingame()) {
 				const hit = driveStartMenu(st.hero);
@@ -374,7 +389,7 @@ import { lib, game, ui, get, ai, _status } from "noname";
 		const st = { total: count, done: 0, t0: Date.now() };
 		saveState(st);
 		await appendText(REPORT, "\n===== AUTO MATCH START " + now() + " target " + count + " matches =====\n");
-		await appendText(REPORT, "  [环境] url=" + location.href + " 引擎就绪=" + ready() + " 武将库=" + ourHeroes().length + "\n");
+		await appendText(REPORT, "  [环境] url=" + location.href + " 引擎就绪=" + ready() + " 武将库=" + ourHeroes().length + " 含yomi的包=" + ourPackKeys().join(",") + "\n");
 		return batchMain(opts.verbose !== false);
 	};
 
