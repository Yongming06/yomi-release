diff --git a/apps/core/_yomi_errors.log b/apps/core/_yomi_errors.log
new file mode 100644
index 0000000..e69de29
diff --git a/apps/core/character/yomi_char_test/skill.js b/apps/core/character/yomi_char_test/skill.js
