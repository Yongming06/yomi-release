--- a/apps/core/character/yomi_char_test/skill.js
+++ b/apps/core/character/yomi_char_test/skill.js
@@ -39,14 +39,13 @@ const skills = {
 		silent: true,
 		trigger: { global: ["gameStart", "phaseBegin"] },
 		filter(event, player, triggername) {
-			// ★ 2026-10-08：改用**第三参** triggername（规范第 2 条）。
-			//   原因：filter 第一参是「源事件」——gameStart 由 mode 的 start 数组（game 事件的 content）触发，
-			//   源事件 name 是 "game" 而不是 "gameStart"；phaseBegin 的源事件 name 是 "phase"。
-			//   原来写 `event.name === "gameStart"` 很可能恒假 → 开局那次「看破」从没生效过。
-			//   ⚠️ 临时探针：把两个值都写进 _yomi_errors.log，跑一局即可确证（确认后删掉这一行）。
-			if (typeof window !== "undefined" && window.__yomiProbe) {
-				window.__yomiProbe("[看破探针] event.name=" + event.name + " triggername=" + triggername + " player=" + (player && player.name));
-			}
+			// ★ 2026-10-08 实测确证：改用**第三参** triggername（规范第 2 条）。
+			//   探针输出（见 _yomi_errors.log）：
+			//     event.name=game    triggername=gameStart
+			//     event.name=phase   triggername=phaseBegin
+			//   → filter 第一参是「源事件」：gameStart 的源事件是 game 事件的 content（name 为 "game"）、
+			//     phaseBegin 的源事件 name 为 "phase"。所以原来 `event.name === "gameStart"` **恒假**，
+			//     开局那次「看破」从未生效（只有自己回合那半条在工作）。
 			return triggername === "gameStart" || event.player === player;
 		},
 		async content(event, trigger, player) {
@@ -282,6 +281,32 @@ const skills = {
 				game.log(player, "【测试·指挥】未能解析牌名：", name, "（原始 link：）", link);
 				return;
 			}
+			// ★ 2026-10-08：应对/奥秘牌**不能直接使用**（卡面 enable:false、content 是空占位），
+			//   用 useCard 强制使用等于「什么都没发生」（用户实机反馈「让其他角色使用应对牌失败了」）。
+			//   测试时真正想要的是「让某人暗置这张应对」→ 直接走暗置流程（与「测试·挂应对」同款）。
+			if (lib.card[name].yomi_respond) {
+				const api = lib.yomiRespond;
+				if (!api) {
+					game.log(player, "【测试·指挥】无法暗置应对牌：本局未加载 yomi_pack_reactive（应对/奥秘包）");
+					return;
+				}
+				if ((actor.storage.yomi_respond_cards || []).length) {
+					game.log(player, "【测试·指挥】", actor, "已经挂了一张应对牌，先等它结算或刷新重开");
+					return;
+				}
+				const rcard = game.createCard(name);
+				if (get.owner(rcard) !== actor) {
+					await actor.gain(rcard, "gain2");
+				}
+				api.register(actor, rcard);
+				await actor.lose(rcard, ui.special);
+				game.log(player, "【测试·指挥】令", actor, "暗置了", rcard);
+				return;
+			}
+			if (lib.card[name].yomi_aomi) {
+				game.log(player, "【测试·指挥】奥秘牌（", get.translation(name), "）不能直接使用，请用正常暗置流程");
+				return;
+			}
 			const t2 = await player
 				.chooseTarget({
 					prompt: `测试·指挥：选择【${get.translation(name)}】的目标`,
