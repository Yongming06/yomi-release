index 0000000..7a64925
--- /dev/null
+++ b/apps/core/_yomi_devtools.js
@@ -0,0 +1,201 @@
+/* ============================================================================
+ * 【仅本地开发】自动对局回归测试（无名杀 · 自制内容项目）
+ *
+ * 为什么放在游戏里而不是外面：无名杀是浏览器游戏，本机的内置浏览器不可用（无 Electron），
+ * 所以由**页面自己**点击菜单跑对局最稳；配合 index.html 里那段「报错自动落盘」钩子，
+ * 每局的报错都会写进 _yomi_errors.log，由开发者（或 AI）事后统一读取分析。
+ *
+ * 用法（任选其一）：
+ *   ① 打开带参数的网址：  http://127.0.0.1:8081/?yomiAuto=20
+ *   ② 游戏里按 F12，在 Console 执行：  __yomiAutoMatch(20)
+ *   ③ 带自定义：  __yomiAutoMatch(20, { maxMinutes: 60, verbose: true })
+ *
+ * 每局结束会往 _yomi_auto_report.txt 追加一行摘要（局号 / 武将 / 时长 / 本局报错数），
+ * 全部结束后写一行「结束」。读取方式（宿主命令行）：
+ *   python tools/_read_game_errors.py            # 报错明细
+ *   type noname\apps\core\_yomi_auto_report.txt  # 对局摘要
+ * ==========================================================================*/
+(function () {
+	if (!/^(127\.0\.0\.1|localhost|\[::1\])$/.test(location.hostname)) return;
+
+	const REPORT = "_yomi_auto_report.txt";
+	const ERRLOG = "_yomi_errors.log";
+	const sleep = ms => new Promise(r => setTimeout(r, ms));
+
+	/* ---------- 文件读写（走游戏自己的文件后端） ---------- */
+	async function readText(name) {
+		try {
+			const r = await fetch("/readFileAsText?fileName=" + name);
+			const j = await r.json();
+			return j && j.success && typeof j.data === "string" ? j.data : "";
+		} catch (e) {
+			return "";
+		}
+	}
+	async function appendText(name, text) {
+		const old = await readText(name);
+		const data = Array.from(new TextEncoder().encode(old + text));
+		try {
+			await fetch("/writeFile", {
+				method: "POST",
+				headers: { "Content-Type": "application/json" },
+				body: JSON.stringify({ path: name, data }),
+			});
+		} catch (e) {}
+	}
+	const errLineCount = async () => (await readText(ERRLOG)).split("\n").length;
+
+	/* ---------- DOM 工具 ---------- */
+	function visible(node) {
+		if (!node || !node.isConnected) return false;
+		const r = node.getBoundingClientRect();
+		return r.width > 0 && r.height > 0;
+	}
+	/** 按可见文本找元素并点击（先精确、再包含） */
+	function clickByText(text, tag) {
+		const all = [...document.querySelectorAll(tag || "*")];
+		const hit =
+			all.find(n => visible(n) && n.textContent.trim() === text && n.children.length === 0) ||
+			all.find(n => visible(n) && n.textContent.trim() === text) ||
+			all.find(n => visible(n) && n.textContent.includes(text) && n.className.includes("button")) ||
+			all.find(n => visible(n) && n.textContent.includes(text));
+		if (!hit) return false;
+		hit.click();
+		return true;
+	}
+	async function waitFor(fn, timeout, step) {
+		const t0 = Date.now();
+		while (Date.now() - t0 < (timeout || 30000)) {
+			try {
+				const v = fn();
+				if (v) return v;
+			} catch (e) {}
+			await sleep(step || 400);
+		}
+		return null;
+	}
+	const inGame = () => window.game && game.me && window.ui && ui.arena && ui.arena.classList.contains("paused") === false;
+
+	/* ---------- 一局：从「主菜单/对局结束」走到开局 ---------- */
+	async function startOneMatch(verbose) {
+		// 1) 目标：进入身份模式对局。菜单文案：开始 → （模式页可能直接开始）→ 开始游戏
+		for (let i = 0; i < 30; i++) {
+			if (window.game && game.me) return true; // 已经在大厅/对局里
+			if (clickByText("开始", "div")) {
+				await sleep(600);
+			}
+			if (clickByText("身份", "div")) {
+				await sleep(400);
+			}
+			if (clickByText("开始游戏", "div") || clickByText("确定", "div")) {
+				await sleep(1500);
+			}
+			// 选将阶段：点「确定」/「自由选将」都不用管，托管后引擎会自己选
+			if (await waitFor(() => (window.game && game.me ? true : null), 3000, 300)) return true;
+			if (verbose) console.log("[自动对局] 等待开局…", i);
+			await sleep(800);
+		}
+		return false;
+	}
+
+	/** 打开托管（AI 接管我方操作） */
+	function enableAuto() {
+		try {
+			if (window.ui && ui.click && typeof ui.click.auto === "function" && !window._status?.auto) {
+				ui.click.auto();
+			}
+			if (window._status) _status.auto = true;
+		} catch (e) {}
+	}
+
+	/** 等本局结束（对局结束后引擎会给出「再战 / 重开」等控制按钮） */
+	async function waitMatchEnd(maxMs, verbose) {
+		const t0 = Date.now();
+		while (Date.now() - t0 < maxMs) {
+			if (window.ui && ui.arena && ui.arena.classList.contains("paused")) {
+				return "paused";
+			}
+			// 结束后出现「再战」或「重开」
+			const endBtn = [...document.querySelectorAll("div")].some(
+				n => visible(n) && (n.textContent.trim() === "再战" || n.textContent.trim() === "重开"),
+			);
+			if (endBtn) return "ended";
+			await sleep(1500);
+			if (verbose && Math.round((Date.now() - t0) / 1000) % 30 === 0) {
+				console.log("[自动对局] 进行中…", Math.round((Date.now() - t0) / 1000) + "s");
+			}
+		}
+		return "timeout";
+	}
+
+	/* ---------- 主流程 ---------- */
+	window.__yomiAutoMatch = async function (count, opts) {
+		opts = opts || {};
+		count = Math.max(1, parseInt(count) || 5);
+		const perMatchMax = opts.perMatchMaxMs || 8 * 60 * 1000;
+		const verbose = opts.verbose !== false;
+		const t0 = Date.now();
+		await appendText(REPORT, "\n===== 自动对局开始 " + new Date().toISOString() + " 目标 " + count + " 局 =====\n");
+		let ok = 0;
+		for (let i = 1; i <= count; i++) {
+			const before = await errLineCount();
+			const mt = Date.now();
+			const started = await startOneMatch(verbose);
+			if (!started) {
+				await appendText(REPORT, "第 " + i + " 局：❌ 开局失败（菜单没点进去）\n");
+				break;
+			}
+			enableAuto();
+			const why = await waitMatchEnd(perMatchMax, verbose);
+			const after = await errLineCount();
+			const heroes = (() => {
+				try {
+					return game.players
+						.filter(p => p.name && !String(p.name).startsWith("unknown"))
+						.map(p => get.translation(p.name))
+						.join(" / ");
+				} catch (e) {
+					return "?";
+				}
+			})();
+			const line =
+				"第 " +
+				i +
+				" 局：" +
+				(why === "timeout" ? "⏱ 超时中止" : "✅ " + why) +
+				" 用时 " +
+				Math.round((Date.now() - mt) / 1000) +
+				"s 本局新增报错行 " +
+				Math.max(0, after - before) +
+				" 武将：" +
+				heroes +
+				"\n";
+			await appendText(REPORT, line);
+			if (verbose) console.log("[自动对局] " + line.trim());
+			ok++;
+			// 结束 → 点「再战」或重开，进入下一局
+			if (why === "ended") {
+				if (!clickByText("再战", "div")) clickByText("重开", "div");
+			}
+			await sleep(2500);
+			enableAuto();
+		}
+		await appendText(
+			REPORT,
+			"===== 自动对局结束 " + new Date().toISOString() + "：完成 " + ok + "/" + count + " 局，总用时 " + Math.round((Date.now() - t0) / 1000) + "s =====\n",
+		);
+		if (verbose) console.log("[自动对局] 全部结束");
+		return ok;
+	};
+
+	// 支持 ?yomiAuto=20 直接开跑（延迟 8 秒等游戏加载完）
+	const m = /[?&]yomiAuto=(\d+)/.exec(location.search);
+	if (m) {
+		console.log("[自动对局] 检测到 yomiAuto 参数，8 秒后开始 " + m[1] + " 局");
+		setTimeout(() => {
+			window.__yomiAutoMatch(m[1]);
+		}, 8000);
+	} else {
+		console.log("[自动对局] 已就绪：控制台执行 __yomiAutoMatch(20) 或访问 ?yomiAuto=20");
+	}
+})();
