+/** 生成一组同名技能需要的翻译键（主技能 + 各 sub 载体） */
+function skillKeys(id, def, subs = []) {
+	const obj = {
+		[id]: def.name,
+		[`${id}_info`]: def.info,
+	};
+	for (const sub of subs) {
+		obj[`${id}_${sub}`] = def.name;
+		obj[`${id}_${sub}_info`] = `（内部载体）${def.info}`;
+	}
+	return obj;
+}
