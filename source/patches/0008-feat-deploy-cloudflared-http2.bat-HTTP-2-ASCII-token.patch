 1 file changed, 28 insertions(+)
 create mode 100644 deploy/cloudflared-http2.bat

diff --git a/deploy/cloudflared-http2.bat b/deploy/cloudflared-http2.bat
new file mode 100644
index 0000000..7c07411
--- /dev/null
+++ b/deploy/cloudflared-http2.bat
@@ -0,0 +1,28 @@
+@echo off
+rem ============================================================================
+rem Start the noname Cloudflare tunnel with HTTP/2 instead of QUIC.
+rem Why: on this network QUIC gave ~6 KB/s while HTTP/2 gives ~25-42 KB/s
+rem      (measured 2026-10-07; see the online-server doc, section 9).
+rem
+rem Token: read from (in this order)
+rem   1) env var CLOUDFLARED_TUNNEL_TOKEN
+rem   2) file <repo root>\.cloudflare-tunnel-token   (single line, no quotes)
+rem Keep that file private - it is git-ignored.
+rem
+rem NOTE: this .bat must stay PURE ASCII. Chinese characters in a .bat get
+rem garbled by cmd's OEM code page and break the script (see the intranet
+rem guide, section 7.5) - that is why every line here is English only.
+rem ============================================================================
+chcp 65001 >nul
+setlocal
+set "EXE=C:\Program Files (x86)\cloudflared\cloudflared.exe"
+set "TOKEN=%CLOUDFLARED_TUNNEL_TOKEN%"
+if not defined TOKEN if exist "%~dp0..\.cloudflare-tunnel-token" set /p TOKEN=<"%~dp0..\.cloudflare-tunnel-token"
+if not defined TOKEN (
+  echo [ERROR] tunnel token not found.
+  echo         set CLOUDFLARED_TUNNEL_TOKEN, or create .cloudflare-tunnel-token in the repo root.
+  exit /b 1
+)
+echo [noname] starting cloudflared with --protocol=http2
+"%EXE%" tunnel run --protocol=http2 --token "%TOKEN%"
+endlocal
