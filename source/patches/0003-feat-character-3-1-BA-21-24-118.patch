+import { lib, game, ui, get, ai, _status } from "noname";
+
+/**
+ * 自制武将包「原神」（包名 yomi_char_genshin）
+ *   - 雷电将军（神/4）：神眼、梦想
+ *   - 摩拉克斯（神/5）：璋护、金汤、天星、武神
+ *
+ * 通用约定：
+ * 1. 【命名规范】开发者代号 yomi（v0.12 起；v0.11 及以前为 ym）—— 包内一切
+ *    自定义命名实体一律加 `yomi_` 前缀
+ *    （技能 id、子技能 id、标记名、player.storage 键、音频文件名）。
+ *    否则会与本体或其他扩展重名被**静默覆盖**（曾踩坑：wushen / tianxing / shenyan）。
+ *    新增前先查：D:\Documents\dsh-YMCG003.online-agent\名称登记表.md
+ * 2. 【翻译】每个技能（含 sub 子技能）都要在 translate.js 里给中文名，
+ *    否则弹窗会显示英文 id。
+ * 3. 【台词/音频】技能要写 `audio`，才会去读 `#<技能id><序号>`；
+ *    引擎 SkillAudio.defaultInfo = false，不写 audio 则 parseAudio() 返回空列表。
+ *    本次自定义音频用 `audio: "2:m4a"`：正则 `(?:(.*):|^)(true|\d+)(?::(.*)|$)`
+ *    解析为「2 条台词 + 扩展名 .m4a」（见 get/audio.ts parseAudio）。
+ * 4. 子技能一律 `sub: true`（隐藏）；不想被「获得技能」类效果看到的用 `charlotte: true`。
+ * 5. 必发/锁定效果必须写 `forced: true`，否则引擎会弹「是否发动」确认框。
+ * 6. 【重要】判断 useCard 的牌不要用 `get.itemtype(card) === "card"`：
+ *    引擎会把 event.card 由实体牌转为虚拟牌（见 content.ts handleEquip），
+ *    该判断会恒为假导致技能不触发。虚拟【杀】同样计入。
+ * 7. 护甲是引擎原生属性：`player.hujia` / `player.changeHujia(num, type, limit)`。
+ *    第三参传 `true` 表示上限 5。
+ * 8. 「直到你的下个回合开始」这类窗口用 `player.storage.X = player.phaseNumber` 记录，
+ *    因为 player.phaseNumber 只在该角色自己回合开始时自增。
+ */
+
+/** @type { importCharacterConfig["skill"] } */
+const skills = {
+	// ================================================================
+	// 雷电将军
+	// ================================================================
+
+	// ——————————————————————————————
+	// “愿”标记的显示载体（本身不发动，仅供标记渲染）
+	// ——————————————————————————————
+	yomi_yuan: {
+		sub: true,
+		mark: true,
+		intro: {
+			name: "愿",
+			content: "mark",
+		},
+	},
+
+	// ——————————————————————————————
+	// 神眼
+	// 出牌阶段限一次，你可以弃置一张牌，获得一个“愿”标记。
+	// 若你拥有“愿”标记，当每回合第一次有角色受到伤害时，你进行一次判定，
+	// 若结果为♠，你获得一个“愿”标记。
+	// ——————————————————————————————
+	yomi_shenyan: {
+		// 台词 2 条：#yomi_shenyan1 / #yomi_shenyan2，音频扩展名为 .m4a。
+		// 缺 audio 字段时 SkillAudio.defaultInfo=false，parseAudio() 会直接返回空列表
+		// → 台词既不显示也不播放（见 get/audio.ts:225/269/402）。
+		audio: "2:m4a",
+		enable: "phaseUse",
+		usable: 1,
+		position: "he",
+		filterCard: true,
+		selectCard: 1,
+		filter(event, player) {
+			return player.countCards("he") > 0;
+		},
+		prompt: "弃置一张牌，获得一个“愿”标记",
+		async content(event, trigger, player) {
+			player.addMark("yomi_yuan", 1);
+		},
+		group: ["yomi_shenyan_damage"],
+		ai: {
+			order: 1,
+			result: {
+				player: 1,
+			},
+			threaten: 1.5,
+		},
+	},
+	yomi_shenyan_damage: {
+		sub: true,
+		forced: true,
+		trigger: {
+			global: "damageEnd",
+		},
+		filter(event, player) {
