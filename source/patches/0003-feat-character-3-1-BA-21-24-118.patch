+	// 神酒
+	// 锁定技，你的【桃】和点数大于你当前体力值的【杀】始终视为【酒】。
+	// 每当你使用【酒】，你回复1点体力。
+	// 实现：`mod.cardname`（先例：本体「调剂盐梅」quandao，character/extra/skill.js:631）。
+	//   ⚠️ 在 cardname 内**不能**调用 `get.name(card)`（会无限递归），必须读 `card.name` 原值。
+	// ——————————————————————————————
+	yomi_barbatos_shenjiu: {
+		forced: true,
+		locked: true,
+		mod: {
+			cardname(card, player) {
+				const raw = card && card.name;
+				if (raw === "tao") {
+					return "jiu";
+				}
+				if (raw === "sha") {
+					const num = Number(card.number);
+					// 点数大于「当前体力值」→ 视为【酒】
+					if (!Number.isNaN(num) && num > player.hp) {
+						return "jiu";
+					}
+				}
+			},
+		},
+		group: ["yomi_barbatos_shenjiu_recover"],
+	},
+	yomi_barbatos_shenjiu_recover: {
+		sub: true,
+		forced: true,
+		silent: true,
+		trigger: { player: "useCard" },
+		filter(event, player) {
+			// useCard 允许无实体牌（content.ts:9759），必须判空再取牌名
+			return !!event.card && get.name(event.card, player) === "jiu";
+		},
+		async content(event, trigger, player) {
+			await player.recover(1);
+		},
+	},
+};
+
+export default skills;
