+				return player.storage[`${id}_skip`] !== game.phaseNumber;
+			},
+			async content(event, trigger, player) {
+				player.storage[`${id}_count`]--;
+				await player.recover(1);
+				if (!player.storage[`${id}_count`]) {
+					player.removeSkill(heal);
+				}
+			},
+		},
+	};
+}
