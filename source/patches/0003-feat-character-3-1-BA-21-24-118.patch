+import { lib, game, ui, get, ai, _status } from "noname";
+import characters from "./character.js";
+import skills from "./skill.js";
+import translates from "./translate.js";
+import characterTitles from "./characterTitle.js";
+
+// 自制武将包「BA」—— 注册入口
+// 包名 `yomi_char_ba` 需与 apps/core/game/package.js 中的键名一致
+//
+// 【自定义势力】本包三个阵营（显示名由 translate.js 统一登记）：
+//   · `abydos`   阿拜多斯（原 `shamo`「沙漠」，2026-10-05 用户要求改为学院名）
+//   · `trinity`  圣三一
+//   · `gehenna`  格黑娜
+//   · `millennium` 千禧年（卡面写「千年」，批次 02 新增）
+//   `lib.group`       决定势力出现在选将筛选等列表里
+//   `lib.groupnature` 决定名牌配色（复用已有 nature：soil / water / devil……）
+lib.group.add("abydos");
+lib.group.add("trinity");
+lib.group.add("gehenna");
+// 批次 02 新增：卡面写「千年」，实际势力＝千禧年（Millennium 科学学园）——用户 2026-10-06 明确
+lib.group.add("millennium");
+lib.groupnature.abydos = "soil"; // 沙漠色
+lib.groupnature.trinity = "water"; // 蓝
+lib.groupnature.gehenna = "devil"; // 暗紫
+lib.groupnature.millennium = "wu"; // 用户 2026-10-06 指定：千禧年配色参照吴势力
+
+game.import("character", function () {
+	return {
+		name: "yomi_char_ba",
+		character: { ...characters },
+		characterTitle: { ...characterTitles },
+		skill: { ...skills },
+		translate: { ...translates },
+	};
+});
