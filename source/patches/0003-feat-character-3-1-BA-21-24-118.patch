@@ -0,0 +1,326 @@
+import { lib, game, ui, get, ai, _status } from "noname";
+
+/**
+ * 自制武将包「测试」（包名 yomi_char_test）—— 测试专用武将
+ *   - 测试专员一（神/10）：看破、调度、无限 + 测试工具（授牌 / 挂应对 / 指挥 / 伤害）
+ *
+ * 通用约定：
+ * 1. 【命名规范】开发者代号 yomi —— 包内一切自定义命名实体一律加 `yomi_` 前缀
+ *    （技能 id、子技能 id、标记名、player.storage 键、音频文件名）。
+ *    否则会与本体或其他扩展重名被**静默覆盖**（曾踩坑：wushen / tianxing / shenyan）。
+ *    新增前先查：D:\Documents\dsh-YMCG003.online-agent\名称登记表.md
+ * 2. 【翻译】每个技能（含 sub 子技能）都要在 translate.js 里给中文名，否则弹窗会显示英文 id。
+ * 3. 子技能一律 `sub: true`（隐藏）；不想被「获得技能」类效果看到的用 `charlotte: true`。
+ * 4. 必发/锁定效果必须写 `forced: true`，否则引擎会弹「是否发动」确认框。
+ * 5. 【重要】判断 useCard 的牌不要用 `get.itemtype(card) === "card"`：
+ *    引擎会把 event.card 由实体牌转为虚拟牌，该判断恒为假导致技能不触发。
+ * 6. 测试工具技能不限次数（不写 usable），用于把对局快速摆到指定局面。
+ * 7. 跨包依赖：`测试·挂应对` 依赖卡包 `yomi_pack_reactive` 暴露的 `lib.yomiRespond`。
+ */
+
+/** @type { importCharacterConfig["skill"] } */
+const skills = {
+	// ================================================================
+	// 测试专员一（测试专用武将）
+	// ================================================================
+
+	// 看破：锁定技，所有其他角色的手牌对你明示。
+	// 实现参照本体「捷悟」（character/clan/skill.js:3178-3280 的 clanjiewu / clanjiewu_view）：
+	//   给**其他角色**逐个挂上 `yomi_ceshi_kanpo_view` 技能并 `markSkill` 点亮 ——
+	//   该技能的 `intro.mark` 会把「该角色自己的手牌」画进技能标记的弹窗里，
+	//   而技能标记是全桌可见的，于是这些手牌对你（以及所有人）就"明示"了。
+	yomi_ceshi_kanpo: {
+		forced: true,
+		locked: true,
+		charlotte: true,
+		// ★ 2026-10-04 修正：不再在**每个角色**的回合开始都重挂一次（那会在你回合开始弹出「看破」之类
+		//   无用提示），改为「游戏开始 + 自己回合开始」；同时关掉 popup / 置 silent，避免弹无用提示。
+		popup: false,
+		silent: true,
+		trigger: { global: ["gameStart", "phaseBegin"] },
+		filter(event, player) {
+			return event.name === "gameStart" || event.player === player;
+		},
+		async content(event, trigger, player) {
+			for (const target of game.filterPlayer(current => current !== player)) {
+				target.addSkill("yomi_ceshi_kanpo_view");
+				target.markSkill("yomi_ceshi_kanpo_view", null, null, true);
+			}
+		},
+	},
+
+	// 看破的显示载体（挂在**其他角色**身上，展示他们自己的手牌）
+	yomi_ceshi_kanpo_view: {
+		charlotte: true,
+		intro: {
+			markcount: (content, player) => player.countCards("h").toString(),
+			mark(dialog, content, player) {
+				const hs = player.getCards("h");
+				if (hs.length) {
+					dialog.addSmall(hs);
+				} else {
+					dialog.addText("没有手牌");
+				}
+			},
+		},
+	},
+
+	// 调度：出牌阶段，**无限次数**，从牌堆 / 弃牌堆 / 其他角色区域内选一张牌置入你的手牌。
+	yomi_ceshi_diaodu: {
+		enable: "phaseUse",
+		// 不写 usable = 不限次数
+		filter(event, player) {
+			return true;
+		},
+		async content(event, trigger, player) {
+			// ── 第一步：选择要取牌的**区域**（该区域没有牌时，不出现这个选项）──
+			const choices = [];
+			if (ui.cardPile.childNodes.length) {
+				choices.push("牌堆");
+			}
+			if (ui.discardPile.childNodes.length) {
+				choices.push("弃牌堆");
+			}
+			if (game.hasPlayer(current => current !== player && current.getCards("hej").length)) {
+				choices.push("其他角色区域");
+			}
+			if (!choices.length) {
+				return;
+			}
+			const first = await player
+				.chooseControl(choices)
+				.set("prompt", "调度：选择要取牌的区域")
+				.set("ai", () => "牌堆")
+				.forResult();
+			const choice = first.control;
+			// ── 第二步：在你选择的区域里挑一张牌 ──
+			const cards = [];
+			if (choice === "牌堆") {
+				// 牌堆：全部（测试武将，不做张数限制）
+				cards.addArray(Array.from(ui.cardPile.childNodes));
+			} else if (choice === "弃牌堆") {
+				cards.addArray(Array.from(ui.discardPile.childNodes));
+			} else {
+				// 其他角色区域：所有其他角色的手牌 / 装备区 / 判定区
+				for (const target of game.filterPlayer(current => current !== player)) {
+					cards.addArray(target.getCards("hej"));
+				}
+			}
+			if (!cards.length) {
+				return;
+			}
+			// ★ chooseButton 的第二个参数必须是**纯牌数组**（本体实例：character/sp/skill.js:31650 的「印卡」）。
+			//   ⚠️ 踩坑记录（两次都报「button不合法」，library/element/button.js:51）：
+			//     ① 把「一组牌」当作单个按钮 item 传；② 把「[[文本, 牌组], ...]」整体当第二个参数传。
+			const second = await player
+				.chooseButton(["调度：选择一张牌置入你的手牌", cards], true)
+				.set("ai", button => 1 + get.value(button.link))
+				.forResult();
+			if (!second.bool || !second.links || !second.links.length) {
+				return;
+			}
+			const card = second.links[0];
+			await player.gain(card, "gain2");
+			game.log(player, "调用了", card);
+		},
+		ai: {
+			order: 10,
+			result: {
+				player: 1,
+			},
+		},
+	},
+
+	// 无限：锁定技，你没有手牌上限。
+	// 实现：用引擎的「手牌上限修正」钩子 mod.maxHandcard 返回一个很大的值（本体先例：
+	//   character/offline/skill/offline_yongjian.js:444 的 `maxHandcard: () => 1`）。
+	//   这里取 99 —— 对测试而言与「无限」等价，同时避免界面显示 `Infinity` 之类的异常值。
+	yomi_ceshi_wuxian: {
+		forced: true,
+		locked: true,
+		mod: {
+			maxHandcard(player, num) {
+				return 99;
+			},
+		},
+	},
+
+	// ================================================================
+	// 测试工具（测试专员一专用 · v0.28）：把对局快速摆到指定局面
+	//   目的是让「应对 / 奥秘 / 濒死 / AI 使用指定牌」这些回归场景 2 次点击即可复现，
+	//   从而不再靠运气或联机双开。不限次数（不写 usable）。
+	// ================================================================
+
+	// 测试·授牌：把你的一张牌（手牌/装备）直接交给任意角色（**含对手**）
+	yomi_ceshi_shoupai: {
+		enable: "phaseUse",
+		filter(event, player) {
+			return player.countCards("he") > 0 && game.hasPlayer(current => current !== player);
+		},
+		async content(event, trigger, player) {
+			const t = await player
+				.chooseTarget({
+					prompt: "测试·授牌：选择牌要交给谁",
+					filterTarget: (card, p, t) => t !== p,
+					selectTarget: 1,
+				})
+				.forResult();
+			if (!t.bool || !t.targets || !t.targets.length) {
+				return;
+			}
+			const target = t.targets[0];
+			const c = await player
+				.chooseCard({ prompt: "测试·授牌：选择要交出的牌", position: "he", selectCard: 1 })
+				.forResult();
+			if (!c.bool || !c.cards || !c.cards.length) {
+				return;
+			}
+			await player.give(c.cards, target);
+			game.log(player, "【测试·授牌】把", c.cards, "交给了", target);
+		},
+		ai: { order: 0.1, result: { player: 0.01 } },
+	},
+
+	// 测试·挂应对：从牌堆/弃牌堆/场上挑一张「应对牌」，直接令任意角色暗置（绕过其 AI 决策）
+	yomi_ceshi_gua: {
+		enable: "phaseUse",
+		filter(event, player) {
+			return game.hasPlayer(current => current !== player);
+		},
+		async content(event, trigger, player) {
+			const api = lib.yomiRespond;
+			if (!api) {
+				game.log(player, "【测试·挂应对】未能执行：游戏内未加载 yomi_pack_reactive（应对/奥秘包）");
+				return;
+			}
+			const t = await player
+				.chooseTarget({
+					prompt: "测试·挂应对：选择要挂上应对牌的角色",
+					// ★ v0.30：允许选自己（测试时需要给「自己」挂应对，例如验证自身镜像场景）
+					filterTarget: () => true,
+					selectTarget: 1,
+				})
+				.forResult();
+			if (!t.bool || !t.targets || !t.targets.length) {
+				return;
+			}
+			const target = t.targets[0];
+			if ((target.storage.yomi_respond_cards || []).length) {
+				game.log(player, "【测试·挂应对】", target, "已经挂了一张应对牌，先等它结算或刷新重开");
+				return;
+			}
+			// 收集所有可见区域的牌（牌堆 / 弃牌堆 / 各角色的手牌、装备、判定区）
+			const pool = [];
+			pool.addArray(Array.from(ui.cardPile.childNodes));
+			pool.addArray(Array.from(ui.discardPile.childNodes));
+			for (const cur of game.filterPlayer()) {
+				pool.addArray(cur.getCards("hej"));
+			}
+			const respondCards = pool.filter(card => api.isRespondCard(card));
+			if (!respondCards.length) {
+				game.log(player, "【测试·挂应对】牌堆/弃牌堆/场上没有可用的应对牌");
+				return;
+			}
+			// ⚠ chooseButton 第二个参数必须是**纯牌数组**（踩过两次：传一组牌 / 传 [[文本,牌组],…] 都会报 button 不合法）
+			const b = await player.chooseButton(["测试·挂应对：选择一张应对牌", respondCards], true).forResult();
+			if (!b.bool || !b.links || !b.links.length) {
+				return;
+			}
+			const card = b.links[0];
+			if (get.owner(card) !== target) {
+				await target.gain(card, "gain2");
+			}
+			// 登记 + 移入特殊区（与正常暗置完全同款）
+			api.register(target, card);
+			await target.lose(card, ui.special);
+			game.log(player, "【测试·挂应对】令", target, "暗置了", card);
+		},
+		ai: { order: 0.1, result: { player: 0.01 } },
+	},
+
+	// 测试·指挥：令任意角色立即对任意角色使用一张你指定牌名的牌
+	yomi_ceshi_zhihui: {
+		enable: "phaseUse",
+		filter() {
+			return true;
+		},
+		async content(event, trigger, player) {
+			const t1 = await player
+				.chooseTarget({ prompt: "测试·指挥：选择要指使的角色", filterTarget: () => true, selectTarget: 1 })
+				.forResult();
+			if (!t1.bool || !t1.targets || !t1.targets.length) {
+				return;
+			}
+			const actor = t1.targets[0];
+			const list = lib.inpile.filter(name => lib.card[name]);
+			const b = await player.chooseButton(["测试·指挥：选择要令其使用的牌名", [list, "vcard"]], true).forResult();
+			if (!b.bool || !b.links || !b.links.length) {
+				return;
+			}
+			// ★ 修正（v0.28.2）：`chooseButton` 的 "vcard" 按钮，其 `link` 是**数组** `[类型, 花色, 牌名]`
+			//   （本体写法：`button.link[2]`，见 character/onlyOL/skill.js:9206）。
+			//   之前当成字符串 → `get.translation` 显示成「锦囊、顺手牵羊」，塞进 `useCard` 后
+			//   `get.info` 取不到 → `player.js:7730 info.changeTarget` 报错（已踩两次）。
+			const link = b.links[0];
+			let name;
+			if (Array.isArray(link)) {
+				name = link[2];
+			} else if (typeof link === "string") {
+				name = link;
+			} else if (link && typeof link === "object") {
+				name = link.name;
+			}
+			if (typeof name !== "string" || !lib.card[name]) {
+				game.log(player, "【测试·指挥】未能解析牌名：", name, "（原始 link：）", link);
+				return;
+			}
+			const t2 = await player
+				.chooseTarget({
+					prompt: `测试·指挥：选择【${get.translation(name)}】的目标`,
+					filterTarget: () => true,
+					selectTarget: 1,
+				})
+				.forResult();
+			if (!t2.bool || !t2.targets || !t2.targets.length) {
+				return;
+			}
+			const target = t2.targets[0];
+			game.log(player, "【测试·指挥】令", actor, "对", target, "使用了", get.translation(name));
+			await actor.useCard({ name }, target).set("addCount", false);
+		},
+		ai: { order: 0.1, result: { player: 0.01 } },
+	},
+
+	// 测试·伤害：对任意角色造成 1/2/3 点伤害，或直接令其进入濒死
+	yomi_ceshi_shanghai: {
+		enable: "phaseUse",
+		filter() {
+			return true;
+		},
+		async content(event, trigger, player) {
+			const t = await player
+				.chooseTarget({ prompt: "测试·伤害：选择目标", filterTarget: () => true, selectTarget: 1 })
+				.forResult();
+			if (!t.bool || !t.targets || !t.targets.length) {
+				return;
+			}
+			const target = t.targets[0];
+			const c = await player
+				.chooseControl(["1点伤害", "2点伤害", "3点伤害", "令其濒死"])
+				.set("prompt", "测试·伤害：选择效果")
+				.set("ai", () => "1点伤害")
+				.forResult();
+			const choice = c.control;
+			game.log(player, "【测试·伤害】对", target, "执行：", choice);
+			if (choice === "令其濒死") {
+				// 造成等同于其当前体力的伤害 → 体力归 0 → 进入濒死
+				await target.damage(Math.max(1, target.hp), player);
+			} else {
+				await target.damage(parseInt(choice), player);
+			}
+		},
+		ai: { order: 0.1, result: { player: 0.01 } },
+	},
+};
+
+export default skills;
