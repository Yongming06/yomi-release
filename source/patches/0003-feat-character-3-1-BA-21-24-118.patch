+				//   · `cardEnabled2` 只在「传入的是实体牌」时被调用（library/index.js:11320 / 11370），
+				//     且 **cardEnabled 与 cardRespondable 都会优先查 cardEnabled2**；
+				//   · 濒死时用【桃】自救走的是 respond 通道（cardRespondable），只有 cardEnabled2 拦得住。
+				//   标记里存的是「被禁当时」使用者的 phaseNumber；到其下个回合开始时自增 → 自动解禁。
+				cardEnabled2(card, player) {
+					if (card.storage[`${id}_ban`] === player.phaseNumber) {
+						return false;
+					}
+				},
+			},
+		},
+	};
