+				if ((name === "tao" || name === "jiu") && get.attitude(player, user) < 0) {
+					return true;
+				}
+				// ③ 敌人对己方残血角色（含主公）使用伤害牌：保护
+				if (get.tag(card, "damage") && get.attitude(player, user) < 0) {
+					if (targets.some(t => t.hp <= 2 && (t === player || get.attitude(player, t) > 0))) return true;
+				}
+				return false;
+			},
+			filter(event, player) {
+				// 只在自己以外的角色回合、其使用一张**实体牌**时可用（虚拟牌无法「回到手牌」）
+				if (event.player === player) {
+					return false;
+				}
+				if (_status.currentPhase === player) {
+					return false;
+				}
+				if (!event.card || !event.cards || !event.cards.length) {
+					return false;
+				}
+				// 代价是弃两张牌
+				return player.countCards("he") >= 2;
+			},
+			async content(event, trigger, player) {
+				const user = trigger.player;
+				const cards = trigger.cards.slice();
+				const discard = await player
+					.chooseToDiscard({
+						position: "he",
+						selectCard: 2,
+						forced: true,
+						prompt: "推进：弃两张牌，令此牌的使用无效并回到其手牌",
+					})
+					.forResult();
+				if (!discard.bool || !discard.cards || discard.cards.length < 2) {
+					return;
+				}
+				game.log(player, "发动【推进】，令", user, "使用的", trigger.card, "无效");
+				// ① 令该使用无效
+				trigger.neutralize();
+				// ② 该牌回到使用者手牌
+				if (cards.length) {
+					await user.gain(cards, "gain2");
+					// ③ 直到其下个回合开始时不可使用
+					for (const card of cards) {
+						card.storage[`${id}_ban`] = user.phaseNumber;
+					}
+					if (!user.hasSkill(ban)) {
+						user.addSkill(ban);
+					}
+				}
+				// ④ 你获得一点护甲值
+				await player.changeHujia(1);
+			},
+		},
+		[ban]: {
+			sub: true,
+			charlotte: true,
+			silent: true,
+			forced: true,
+			// 自己的回合开始 → 清掉过期标记，身上再没有被禁的牌就摘掉载体（避免残留技能）
+			trigger: { player: "phaseBegin" },
+			async content(event, trigger, player) {
+				let still = false;
+				for (const card of player.getCards("hej")) {
+					const mark = card.storage[`${id}_ban`];
+					if (mark === undefined) {
+						continue;
+					}
+					if (mark < player.phaseNumber) {
+						// 已过期（使用者回合已翻页）→ 删除标记
+						delete card.storage[`${id}_ban`];
