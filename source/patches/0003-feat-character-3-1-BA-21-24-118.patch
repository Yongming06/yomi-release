+			},
+			derivation: ["yingzi", "yomi_ba_huixue", "yomi_ba_hongke", "yomi_ba_jiagong"],
+			async content(event, trigger, player) {
+				const discard = await player
+					.chooseToDiscard({ position: "he", selectCard: 1, forced: true, prompt: "冲浪：弃置一张牌" })
+					.forResult();
+				if (!discard.bool || !discard.cards || !discard.cards.length) return;
+				// ★ 重新获得衍生技之前，先清掉「已选过目标」的旗标：
+				//   红克/加攻 的效果是「获得本技能时指定至多三名角色」，
+				//   第二轮及以后重新获得它们时，必须**重新弹窗选人**（2026-10-05 用户要求）。
+				delete player.storage.yomi_ba_hongke_done;
+				delete player.storage.yomi_ba_jiagong_done;
+				// 衍生技：先失去先前获得的，再获得新的（addAdditionalSkills 的 keep=false 语义）
+				//   → 失去时会触发各自的 onremove（撤掉旧目标身上的 buff），获得时触发
+				//     changeSkillsAfter → 红克/加攻 重新询问目标
+				// ★ 重新授予衍生技：必须走引擎 API（它负责 additionalSkills 记账 + game.broadcast），
