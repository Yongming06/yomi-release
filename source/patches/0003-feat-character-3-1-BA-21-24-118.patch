+/** 向上找最近一个带 targets 的祖先事件（用于判断「多目标效果」） */
+function nearestTargetsEvent(event) {
+	let evt = event.getParent();
+	for (let i = 0; i < 6 && evt; i++) {
+		if (evt.targets) return evt;
+		evt = evt.getParent();
+	}
+	return null;
+}
