+import { lib, game, ui, get, ai, _status } from "noname";
+
+/**
+ * 自制武将包「BA」（包名 yomi_char_ba）—— 技能实现
+ *
+ * ============================================================
+ * 【本包最大特点：同一技能名会在很多武将身上重复出现】
+ * ============================================================
+ * 用户要求（2026-10-05）：
+ *   1. 同名 + 同效果 的技能，**游戏内显示（技能名 / 描述）与效果处理完全一致**；
+ *   2. 但代码层面必须**逐武将区分**：首次出现用 `yomi_ba_xxx`，第二个武将开始
+ *      依次加后缀 `2`、`3`、`4`……（如 `yomi_ba_qianpai` / `yomi_ba_qianpai2` / …），
+ *      这样日后想单独调整某个武将不会牵连其他武将；
+ *   3. 同名但**不同效果**的技能，同样用独立 id 区分，并在 `名称登记表.md` 里注明差异。
+ *
+ * 实现方式（重要）：同名技能一律走**工厂函数**，例如 `makeQianpai("yomi_ba_qianpai2")`。
+ *   工厂每次都返回**全新对象**（引擎载入技能时会往 info 上写 `_priority` 等字段，
+ *   共用同一个对象会互相污染），因此「显示一致、实现独立」两不误。
+ *   子技能 id 由主 id 派生（`<主id>_force` / `<主id>_ban` / `<主id>_heal`），天然跟着后缀走。
+ *
+ * ============================================================
+ * 通用约定（与其它自制包一致）
+ * ============================================================
+ * 1. 一切自定义命名实体加 `yomi_` 前缀（技能 id / 子技能 id / 标记名 / storage 键）。
+ * 2. 每个技能（含 sub 子技能）都要在 translate.js 里给中文名，否则弹窗显示英文 id。
+ * 3. 必发 / 锁定 / 载体技能一律 `forced: true` + `silent: true`（引擎对 yomi_ 前缀 + trigger + forced
+ *    的技能会自动补 silent，显式写是双保险）；「可以选择」的技能**绝不能**写 silent。
+ * 4. 判断 useCard 的牌不要用 `get.itemtype(card) === "card"`，直接用 `get.name/get.tag/get.nature`。
+ * 5. 跨回合窗口用 `player.storage.X = player.phaseNumber`，filter 里判 `===`。
+ */
+
+/** @type { importCharacterConfig["skill"] } */
+const skills = {
+	// ================================================================
+	// 技能工厂们（同名技能重复出现时调用，返回「全新」的技能表片段）
+	// ================================================================
+
+	...makeQianpai("yomi_ba_qianpai"),
+	...makeTuijin("yomi_ba_tuijin"),
+	...makeHuanjiu("yomi_ba_huanjiu"),
+
+	// ================================================================
+	// 批次 01（2026-10-05）—— 8 个新武将
+	//   同名技能：前排/后排走工厂加后缀；破甲/钻弹/终幕同名不同效果各写一份
+	// ================================================================
+	...makeQianpai("yomi_ba_qianpai2"), // 星野（临战）防御
+	...makeHoupai("yomi_ba_houpai"), // 日奈（礼服）
+	...makeHoupai("yomi_ba_houpai2"), // 日奈（泳装）
+	...makeHoupai("yomi_ba_houpai3"), // 日奈
+	...makeChonglang("yomi_ba_chonglang"), // 星野（泳装）
+	...makeYanti("yomi_ba_yanti"), // 星野（防御）掩体
+	...makeYashe("yomi_ba_yashe"), // 星野（攻击）压射
+
+	// —— 临时护甲（「临」标记）系统载体：用户 2026-10-05 设计 ——
+	yomi_ba_temp_hujia: {
+		charlotte: true,
+		silent: true,
+		forced: true,
+		popup: false,
+		marktext: "临",
+		intro: {
+			name: "临",
+			content(storage, player) {
+				return `临时护甲 ${(player.storage.yomi_ba_temp_hujia || []).length} 点`;
+			},
+		},
+		// 护甲减少 → 同步扣除等量的「临」（先进先出）
+		trigger: { player: "changeHujiaAfter" },
+		filter(event) {
+			return event.num < 0 && !event.yomi_ba_temp_removing;
+		},
+		async content(event, trigger, player) {
+			const list = player.storage.yomi_ba_temp_hujia || [];
+			list.splice(0, Math.min(-trigger.num, list.length));
+			refreshTempHujia(player);
+		},
+		group: ["yomi_ba_temp_hujia_expire"],
+	},
+	// 到点清除：每个「临」都记着它被生成时技能规定的清除时限
+	yomi_ba_temp_hujia_expire: {
+		charlotte: true,
+		silent: true,
+		forced: true,
+		popup: false,
+		trigger: { player: "phaseBegin" },
+		filter(event, player) {
+			return (player.storage.yomi_ba_temp_hujia || []).some(i => i.expire === "phaseBegin");
+		},
+		async content(event, trigger, player) {
+			expireTempHujia(player, "phaseBegin");
+		},
+	},
+
+	// —— 星野（泳装）：衍生技 ——
+	yomi_ba_huixue: {
+		forced: true,
+		locked: true,
+		sub: true,
+		charlotte: true,
+		trigger: { player: "phaseJieshuBegin" },
+		async content(event, trigger, player) {
+			await player.recover(1);
+		},
+	},
+	yomi_ba_hongke: {
+		forced: true,
+		locked: true,
+		sub: true,
+		charlotte: true,
+		trigger: { player: "changeSkillsAfter" },
+		filter(event, player) {
+			return !player.storage.yomi_ba_hongke_done;
+		},
+		async content(event, trigger, player) {
+			player.storage.yomi_ba_hongke_done = true;
+			const { targets } = await player
+				.chooseTarget({
+					prompt: "红克：指定至多三名角色，其造成的超过一点的火焰伤害翻倍",
+					selectTarget: [0, 3],
+					ai: aiAlly(player), // 增益：优先自己与队友
+				})
+				.forResult();
+			for (const target of targets || []) {
+				target.addSkill("yomi_ba_hongke_buff");
+				// ★ 记录来源：同名 buff 是**公共技能**，两个「星野（泳装）」可能给同一目标上 buff，
+				//   不分来源地 removeSkill 会把别人的一起摘掉（子代理复核 low 项）
+				if (!target.storage.yomi_ba_hongke_sources) target.storage.yomi_ba_hongke_sources = [];
+				target.storage.yomi_ba_hongke_sources.add(player);
+				if (!player.storage.yomi_ba_hongke_targets) player.storage.yomi_ba_hongke_targets = [];
+				player.storage.yomi_ba_hongke_targets.push(target);
+			}
+		},
+		onremove(player) {
+			for (const target of player.storage.yomi_ba_hongke_targets || []) {
+				// 只摘「自己这一份」：其它来源还在就没收 buff
+				if (target.storage.yomi_ba_hongke_sources) target.storage.yomi_ba_hongke_sources.remove(player);
+				if (!(target.storage.yomi_ba_hongke_sources || []).length) {
+					delete target.storage.yomi_ba_hongke_sources;
+					target.removeSkill("yomi_ba_hongke_buff");
+				}
+			}
+			delete player.storage.yomi_ba_hongke_targets;
+			delete player.storage.yomi_ba_hongke_done;
+		},
+	},
+	yomi_ba_jiagong: {
+		forced: true,
+		locked: true,
+		sub: true,
+		charlotte: true,
+		trigger: { player: "changeSkillsAfter" },
+		filter(event, player) {
+			return !player.storage.yomi_ba_jiagong_done;
+		},
+		async content(event, trigger, player) {
+			player.storage.yomi_ba_jiagong_done = true;
+			const { targets } = await player
+				.chooseTarget({
+					prompt: "加攻：指定至多三名角色，其使用的伤害牌伤害+1",
+					selectTarget: [0, 3],
+					ai: aiAlly(player), // 增益：优先自己与队友
+				})
+				.forResult();
+			for (const target of targets || []) {
+				target.addSkill("yomi_ba_jiagong_buff");
+				if (!target.storage.yomi_ba_jiagong_sources) target.storage.yomi_ba_jiagong_sources = [];
+				target.storage.yomi_ba_jiagong_sources.add(player);
+				if (!player.storage.yomi_ba_jiagong_targets) player.storage.yomi_ba_jiagong_targets = [];
+				player.storage.yomi_ba_jiagong_targets.push(target);
+			}
+		},
+		onremove(player) {
+			for (const target of player.storage.yomi_ba_jiagong_targets || []) {
+				if (target.storage.yomi_ba_jiagong_sources) target.storage.yomi_ba_jiagong_sources.remove(player);
+				if (!(target.storage.yomi_ba_jiagong_sources || []).length) {
+					delete target.storage.yomi_ba_jiagong_sources;
+					target.removeSkill("yomi_ba_jiagong_buff");
+				}
+			}
+			delete player.storage.yomi_ba_jiagong_targets;
+			delete player.storage.yomi_ba_jiagong_done;
+		},
+	},
+	yomi_ba_hongke_buff: {
+		sub: true,
+		charlotte: true,
+		silent: true,
+		forced: true,
+		popup: false,
+		trigger: { source: "damageBegin3" },
+		filter(event, player) {
+			// 来源全部阵亡后失效（死亡不会触发 onremove，这里按存活来源判断，子代理复核 medium 项）
+			if (!(player.storage.yomi_ba_hongke_sources || []).some(s => s.isAlive())) return false;
+			return event.nature === "fire" && event.num > 1;
+		},
+		async content(event, trigger, player) {
+			trigger.num *= 2;
+		},
+	},
+	yomi_ba_jiagong_buff: {
+		sub: true,
+		charlotte: true,
+		silent: true,
+		forced: true,
+		popup: false,
+		trigger: { source: "damageBegin1" },
+		filter(event, player) {
+			if (!(player.storage.yomi_ba_jiagong_sources || []).some(s => s.isAlive())) return false;
+			return event.card && get.tag(event.card, "damage");
+		},
