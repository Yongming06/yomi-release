+					const next = trigger.player.damage(1, player, trigger.nature, trigger.card);
+					next.set(`${id}_point`, true); // ⑤ 标记「拆分出的 1 点」
+					next.set("nohujia", true); // 无视护甲值
+				}
+				game.log(player, "的【压射】把", get.cnNumber(trigger.num), "点伤害拆成", get.cnNumber(num), "次 1 点");
+			},
+		},
+		[`${id}_true`]: {
