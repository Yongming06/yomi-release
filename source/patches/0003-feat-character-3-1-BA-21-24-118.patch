+// 自制武将包「原神」（包名 yomi_char_genshin）—— 武将基本信息
+// 格式：{ 武将id: { sex: 性别, group: 势力, hp: 体力, skills: [技能id...] } }
+//
+// 【命名规范】开发者代号 yomi —— 包内一切自定义命名
+//   实体（武将 id / 技能 id / 子技能 id / 标记名 / 台词键 / 音频文件名 / 头像文件名）
+//   统一加 `yomi_` 前缀。
+//   新增前先查：D:\Documents\dsh-YMCG003.online-agent\名称登记表.md
+// 曾经踩过的坑：wushen / tianxing 与本体技能重名、shenyan 与扩展「杀海拾遗」重名，
+//   重名会导致技能被**静默覆盖**，所以现在一律加 yomi_ 前缀。
+//
+// 【迁移说明】本包由原单包 `custom` 拆分而来（2026-10-04），武将 id / 技能 id **保持不变**，
+//   仅包归属变化，历史引用（台词键、音频、头像、storage 键）全部不受影响。
+
+const characters = {
+	// 雷电将军 —— 势力：神，体力：4
+	yomi_leidian: {
+		sex: "female",
+		group: "shen",
+		hp: 4,
+		skills: ["yomi_shenyan", "yomi_mengxiang"],
+		// 阵亡音频：DieAudio 解析该文件名（audio/die/yomi_leidian.m4a），
+		// 但台词文本仍读 lib.translate["#yomi_leidian:die"]，键名要与武将 id 一致。
+		dieAudios: ["yomi_leidian.m4a"],
+	},
+
+	// 摩拉克斯（岩王帝君）—— 势力：神，体力：5
+	yomi_morax: {
+		sex: "male",
+		group: "shen",
+		hp: 5,
+		skills: ["yomi_zhanghu", "yomi_jintang", "yomi_tianxing", "yomi_wushen"],
