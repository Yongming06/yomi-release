+		charlotte: true,
+		silent: true,
+		forced: true,
+		popup: false,
+		trigger: { player: "damageBegin3" },
+		filter(event, player) {
+			return event.source && event.source !== player && !event.source.inRange(player);
+		},
+		async content(event, trigger, player) {
+			trigger.num--;
+		},
+	},
+	yomi_ba_sushe: {
+		trigger: { player: "useCardAfter" },
+		filter(event, player) {
+			return get.name(event.card) === "sha" && event.targets && event.targets.length;
+		},
+		// ★ AI：手里还有【杀】就别发动 —— 展示手牌等于把信息白给对手，而且本来就没有额外收益
+		check(event, player) {
+			return !player.countCards("h", c => get.name(c) === "sha");
+		},
+		async content(event, trigger, player) {
+			const target = trigger.targets[0];
+			await player.showHandcards("速射");
+			if (player.countCards("h", card => get.name(card) === "sha")) return;
+			await target.damage(1, player);
+			await player.draw(1);
+		},
+	},
+	yomi_ba_jishe: {
+		enable: "phaseUse",
+		usable: 1,
+		position: "he",
+		filterCard: true,
+		selectCard: 3,
+		filter(event, player) {
+			return player.countCards("he") >= 3;
+		},
+		prompt: "弃置三张牌，对一名其它角色及其相邻角色中的任意名各使用一张【杀】",
+		async content(event, trigger, player) {
+			const { targets } = await player
+				.chooseTarget({
+					prompt: "集射：选择一名其它角色",
+					filterTarget: lib.filter.notMe,
+					selectTarget: 1,
