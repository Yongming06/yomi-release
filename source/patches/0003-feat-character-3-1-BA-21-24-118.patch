+				let num = trigger.num;
+				if (num < 1) return; // 不足 1 点的小数伤害不拆分（避免 for 循环多打一次）
+				if (num > 1) num -= 1;
+				if (num <= 0) return;
+				// ④ 取消原伤害，拆成 num 个 1 点
+				trigger.cancel();
