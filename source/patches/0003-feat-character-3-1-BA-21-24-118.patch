+			check(event, player) {
+				const user = event.player;
+				const card = event.card;
+				if (!user || !card || user === player) return false;
+				const name = get.name(card);
+				const targets = event.targets || [];
+				// ① 被拆/被顺、且自己手牌 ≤2：既保住之后的出牌能力，又顺手拿 1 护甲
+				if ((name === "guohe" || name === "shunshou") && targets.includes(player) && player.countCards("h") <= 2) {
+					return true;
+				}
