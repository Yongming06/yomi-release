+			//   （否则 selectCard [1, 0] 的弃牌框永远点不了确定）
+			const handCount = player.countCards("h");
+			const controls = [];
+			if (handCount > 0) {
+				controls.push("弃牌换牌");
+			}
+			// 第二项的条件是「目标当前体力值 ≤ 你」，自己天然满足 → 该项恒可用
+			if (game.hasPlayer(current => current.hp <= player.hp)) {
+				controls.push("横置或重置");
+			}
+			if (!controls.length) {
+				return;
+			}
+			const choice = await player
+				.chooseControl(controls)
+				.set("prompt", "风眼：选择以下一项")
+				.set("ai", () => (handCount > 2 ? "弃牌换牌" : controls[controls.length - 1]))
+				.forResult();
+			if (choice.control === "弃牌换牌") {
+				const discard = await player
+					.chooseToDiscard({
+						position: "h",
+						selectCard: [1, handCount],
+						prompt: "风眼：弃置任意张手牌，然后摸等量的牌",
+						ai(card) {
+							return -get.value(card);
+						},
+					})
+					.forResult();
+				if (!discard.bool || !discard.cards || !discard.cards.length) {
+					return;
+				}
+				await player.draw(discard.cards.length);
+				return;
+			}
+			const { bool, targets } = await player
+				.chooseTarget({
+					prompt: "风眼：令任意名体力值不大于你的角色横置或重置",
+					// ★ 用闭包 player（技能持有者 = 巴巴托斯）的**当前体力**比较，不依赖回调参数 p 的语义
+					filterTarget: (card, p, t) => t.hp <= player.hp,
+					selectTarget: [1, Infinity],
+					ai(target) {
+						// 敌人已横置 → 重置掉；敌人未横置 → 横置（属性伤害可传导）
+						return target.isLinked() ? -get.attitude(player, target) : get.attitude(player, target) * 0.6;
+					},
+				})
+				.forResult();
+			if (!bool || !targets || !targets.length) {
+				return;
+			}
+			for (const target of targets) {
+				await target.link();
+			}
+		},
