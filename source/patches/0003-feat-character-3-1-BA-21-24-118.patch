+/** 是否为「伤害牌」（引擎原生判断；自制伤害牌已补 ai.tag.damage） */
+function isDamageCard(card) {
+	return !!get.is.damageCard(card);
+}
+
+/** 伤害事件对应的 useCard 事件（没有则 null） */
+function parentUseCard(event) {
+	return event.getParent("useCard") || null;
+}
+
+/** 伤害是否来自「仅指定一名角色为目标」的伤害牌 */
+function fromSingleTargetCard(event) {
+	const evt = parentUseCard(event);
+	return !!evt && (evt.targets || []).length === 1;
