+	// 风眼
+	// 出牌阶段开始时，你可以选择以下一项：
+	//   1. 弃置任意张手牌，然后摸等量的牌；
+	//   2. 令任意名体力值不大于你的角色横置或重置。
+	//      ★ 2026-10-05 用户确认：卡面「不大于」正确（2026-10-04 曾一度按「不小于」改错，已回退）。
+	//      比较的是**当前体力值**（`player.hp` 即当前体力）；实现用闭包里的技能持有者 `player`，
+	//      不依赖回调第 2 参 `p` 的语义。
+	// ——————————————————————————————
+	yomi_barbatos_fengyan: {
+		trigger: { player: "phaseUseBegin" },
+		filter(event, player) {
+			// 第二项条件为「目标当前体力值 ≤ 你」（含自己）；手牌为 0 时只剩第二项
