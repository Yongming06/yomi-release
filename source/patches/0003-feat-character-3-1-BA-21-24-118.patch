+// ================================================================
+// 周备：你造成的火焰伤害翻倍 + 数值锁定（第三方增/减无效，只有"取消"能影响）
+//   · damageBegin3（增益结算完、且 awaited）：先加后乘 → 翻倍并记下锁定值
+//   · damageBegin4（伤害真正打出前最后一步）：把数值拉回锁定值（除非这次伤害被 cancel）
+//   · 幂等：同一伤害事件只翻一次（主技能与载体都挂此函数，互为双保险）
+// ================================================================
+function zhoubeiDamage(step, trigger, player) {
+	// step 来自 event.triggername（"damageBegin3" / "damageBegin4"）——
+	//   ⚠️ 不能看 trigger.name：damage 类触发传进来的是**伤害事件本身**，其 name 恒为 "damage"，
+	//   这正是之前「周备不翻倍」的真因（代码永远走了 damageBegin4 分支）。
+	//   语义（2026-10-05 用户选定 A 案）：翻倍后的数值**不再被任何后续效果修改**（第三方加/减都无效）。
+	if (step === "damageBegin3") {
+		if (trigger.yomi_ba_zhoubei_doubled) return;
+		trigger.yomi_ba_zhoubei_doubled = true;
+		trigger.num *= 2;
+		trigger.set("yomi_ba_zhoubei_lock", trigger.num);
+		return;
+	}
+	if (trigger._cancelled || trigger.cancelled) return;
+	const lock = trigger.yomi_ba_zhoubei_lock;
+	if (typeof lock === "number" && lock > 0) trigger.num = lock;
+}
