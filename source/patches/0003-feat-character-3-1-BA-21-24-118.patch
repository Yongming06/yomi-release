+					}
+				}
+				if (!still) {
+					player.removeSkill(ban);
+				}
+			},
+			mod: {
+				// ⚠️ 必须用 `cardEnabled2` 而不是 `cardEnabled`（2026-10-05 实机踩坑：被禁的【桃】马上又被用掉）：
