+		[id]: {
+			forced: true,
+			locked: true,
+			group: [guard, `${id}_true`, draw],
+		},
+		[guard]: {
+			sub: true,
+			charlotte: true,
+			silent: true,
+			forced: true,
+			popup: false,
+			trigger: { source: "damageBegin4" },
