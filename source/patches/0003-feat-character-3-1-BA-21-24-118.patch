+// ================================================================
+// 临时护甲（「临」标记）—— 用户 2026-10-05 设计
+//   · 临时护甲直接加进 player.hujia（等价护甲，优先被消耗）
+//   · 同时在 storage 里为「每一点」记一条 {key, expire}，标记显示「临」
+//   · 护甲减少时先进先出扣除；到 expire 时限若标记仍在 → 扣掉对应护甲（不算受伤/失去体力）
+// ================================================================
+function refreshTempHujia(player) {
+	const list = player.storage.yomi_ba_temp_hujia || [];
+	if (!list.length) {
+		delete player.storage.yomi_ba_temp_hujia;
+		player.removeSkill("yomi_ba_temp_hujia");
+		return;
+	}
+	player.addSkill("yomi_ba_temp_hujia");
+	player.markSkill("yomi_ba_temp_hujia");
+}
+
+/** 获得 n 点临时护甲；expire 为清除时限键（"phaseBegin"＝自己下个回合开始；null＝只靠 key 清除） */
+function gainTempHujia(player, num, expire, key) {
+	if (!player.storage.yomi_ba_temp_hujia) player.storage.yomi_ba_temp_hujia = [];
+	for (let i = 0; i < num; i++) player.storage.yomi_ba_temp_hujia.push({ key, expire });
+	player.changeHujia(num);
+	refreshTempHujia(player);
+	game.log(player, "获得了", get.cnNumber(num), "点临时护甲");
+}
+
+/** 按来源 key 清除（例如「掩体」下次发动时清掉上次给的） */
+function clearTempHujiaByKey(player, key) {
+	const list = player.storage.yomi_ba_temp_hujia || [];
+	let n = 0;
+	for (let i = list.length - 1; i >= 0; i--) {
+		if (list[i].key === key) {
+			list.splice(i, 1);
+			n++;
+		}
+	}
+	if (n) reduceTempHujia(player, n);
+	refreshTempHujia(player);
+}
+
+/** 到点清除 */
+function expireTempHujia(player, expire) {
+	const list = player.storage.yomi_ba_temp_hujia || [];
+	let n = 0;
+	for (let i = list.length - 1; i >= 0; i--) {
+		if (list[i].expire === expire) {
+			list.splice(i, 1);
+			n++;
+		}
+	}
+	if (n) reduceTempHujia(player, n);
+	refreshTempHujia(player);
+}
+
+/** 扣护甲但不触发「临」标记的连带扣除（用 locked 旗标防重入） */
+function reduceTempHujia(player, n) {
+	// ⚠️ 不能用 storage 旗标：changeHujia 只把事件推进队列，真正执行在下一个 tick，
+	//   旗标会在同一个同步块里就被删掉 → 到期清除会被误当成"被伤害消耗"而重复扣条目。
+	//   正确做法：标记挂在**事件对象**上，随事件一起排队。
+	const ev = player.changeHujia(-n);
+	ev.yomi_ba_temp_removing = true;
+}
+/** 清掉「终射第 3 次」的翻倍状态（旗标 + 载体）：所有分支（含提前 return）都必须调用 */
+function clearZhongsheDouble(player) {
+	delete player.storage.yomi_ba_zhongshe_third;
+	player.removeSkill("yomi_ba_zhongshe_double");
+}
