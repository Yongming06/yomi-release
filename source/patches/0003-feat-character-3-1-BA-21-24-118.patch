+		[id]: {
+			unique: true,
+			forced: true,
+			locked: true,
+			// 专属台词 2 条（.ogg）
+			audio: "2:ogg",
+			skillAnimation: true,
+			animationColor: "legend",
+			trigger: { global: "phaseJieshuBegin" },
+			filter(event, player) {
+				return !player.storage[id] && player.hp === 1;
+			},
+			async content(event, trigger, player) {
+				player.awakenSkill(id);
+				player.storage[id] = true;
+				game.log(player, "觉醒【缓救】");
+				// 觉醒当下先回复 1 点
+				await player.recover(1);
+				// 之后的四个回合结束时各回复 1 点（跳过本次）
+				player.storage[`${id}_count`] = 4;
+				player.storage[`${id}_skip`] = game.phaseNumber;
+				if (!player.hasSkill(heal)) {
+					player.addSkill(heal);
+				}
+			},
+		},
+		[heal]: {
+			sub: true,
+			charlotte: true,
+			silent: true,
+			forced: true,
+			trigger: { global: "phaseJieshuBegin" },
+			filter(event, player) {
+				if (!player.storage[`${id}_count`]) {
