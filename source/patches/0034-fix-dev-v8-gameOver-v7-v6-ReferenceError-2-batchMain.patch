diff --git a/apps/core/_yomi_devtools.js b/apps/core/_yomi_devtools.js
index 33e0df4..a1bb191 100644
--- a/apps/core/_yomi_devtools.js
+++ b/apps/core/_yomi_devtools.js
@@ -93,6 +93,16 @@ import { lib, game, ui, get, ai, _status } from "noname";
 			return -1;
 		}
 	};
+	// ⚠️ v6 重写时误删了这个函数、v7 又引用了它 → 实机 ReferenceError「gameOver is not defined」✗
+	const gameOver = () => {
+		try {
+			if (_status && _status.over) return true;
+			if (ui && ui.continue_game) return true;
+			return false;
+		} catch (e) {
+			return false;
+		}
+	};
 	const evtChain = () => {
 		try {
 			const out = [];
@@ -328,6 +338,20 @@ import { lib, game, ui, get, ai, _status } from "noname";
 	};
 
 	async function batchMain(verbose) {
+		try {
+			return await batchMainInner(verbose);
+		} catch (e) {
+			// ⚠️ harness 自己的异常必须落盘：否则又是一次「静默不动」✗（2026-10-08 踩过）
+			const msg = (e && e.stack) || String(e);
+			try {
+				await appendText(REPORT, "  ❌ [harness 异常] " + msg + "\n" + window.__yomiSnapshot() + "\n");
+			} catch (e2) {}
+			console.error("[yomi 自动对局] harness 异常：", e);
+			running = false;
+			return null;
+		}
+	}
+	async function batchMainInner(verbose) {
 		if (running) return;
 		running = true;
 		const st = loadState();
@@ -389,7 +413,15 @@ import { lib, game, ui, get, ai, _status } from "noname";
 		const st = { total: count, done: 0, t0: Date.now() };
 		saveState(st);
 		await appendText(REPORT, "\n===== AUTO MATCH START " + now() + " target " + count + " matches =====\n");
-		await appendText(REPORT, "  [环境] url=" + location.href + " 引擎就绪=" + ready() + " 武将库=" + ourHeroes().length + " 含yomi的包=" + ourPackKeys().join(",") + "\n");
+		let packKeys = "?";
+		try {
+			packKeys = Object.keys(lib.characterPack || {}).join(",");
+		} catch (e) {}
+		await appendText(
+			REPORT,
+			"  [环境] url=" + location.href + " 引擎就绪=" + ready() + " 武将库=" + ourHeroes().length +
+				" 含yomi的包=" + ourPackKeys().join(",") + "\n  [环境] characterPack 全部键=" + packKeys + "\n",
+		);
 		return batchMain(opts.verbose !== false);
 	};
 
