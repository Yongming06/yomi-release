diff --git a/deploy/Dockerfile.online b/deploy/Dockerfile.online
new file mode 100644
index 0000000..4310632
--- /dev/null
+++ b/deploy/Dockerfile.online
@@ -0,0 +1,41 @@
+# ==============================================================================
+# 无名杀联机自建服务端（只跑两个 Node 进程，依赖最小化）
+#   · 网页端  @noname/fs      → 127.0.0.1:8089  静态服务 /app/dist（dist 由宿主 `pnpm build` 产出后挂载）
+#   · 大厅    @noname/server  → 0.0.0.0:8082    WebSocket 房间列表 / 房间消息中转
+#
+# 为什么不用仓库根目录的 pnpm 工作区安装：
+#   根工作区会连带 apps/mobile 的 electron 等重量级依赖（本地 node_modules 就有 3.5GB），
+#   而这两个服务端包都是**自包含**的（fs 只用 fastify 系 + minimist；server 只用 ws）→ 单独装最小依赖即可。
+#
+# 为什么用 tsx 直接跑 TS：省掉 packages/*/tsup 构建步骤，镜像更小、改代码更快生效。
+#
+# 关于基础镜像（2026-10-07 实测）：本机 **连不上 Docker Hub**（registry-1.docker.io 超时），
+#   所以默认走国内可用的镜像源；换到能直连 Docker Hub 的机器时，加 `--build-arg BASE_IMAGE=node:lts-slim` 即可。
+#   ⚠️ 不要写 `# syntax=docker/dockerfile:1`：那会额外去 Docker Hub 拉 BuildKit 前端镜像，在本机会直接失败。
+# ==============================================================================
+ARG BASE_IMAGE=docker.m.daocloud.io/library/node:lts-slim
+FROM ${BASE_IMAGE}
+
+# 依赖源同理：容器内 npm 走国内镜像（可用 --build-arg NPM_REGISTRY=... 覆盖）
+ARG NPM_REGISTRY=https://registry.npmmirror.com
+
+ENV TZ=Asia/Shanghai \
+    NODE_ENV=production
+
+WORKDIR /app
+
+# 最小依赖清单（版本对齐 packages/fs 与 packages/server 的 package.json）
+COPY deploy/package.docker.json /app/package.json
+RUN npm install --no-fund --no-audit --registry="${NPM_REGISTRY}" && npm cache clean --force
+
+# 两个服务端源码
+COPY packages/fs/src /app/fs/src
+COPY packages/server/src /app/server/src
+
+COPY deploy/start.sh /app/start.sh
+RUN chmod +x /app/start.sh
+
+# 网页端 8089 / 大厅 8082
+EXPOSE 8089 8082
+
+CMD ["/app/start.sh"]
diff --git a/deploy/docker-compose.yml b/deploy/docker-compose.yml
new file mode 100644
index 0000000..5188ebd
--- /dev/null
+++ b/deploy/docker-compose.yml
@@ -0,0 +1,39 @@
+# ==============================================================================
+# 无名杀联机自建服务端（Docker Compose）
+#
+#   构建并启动： docker compose -f deploy/docker-compose.yml up -d --build
+#   看日志：     docker compose -f deploy/docker-compose.yml logs -f --tail 100
+#   重启：       docker compose -f deploy/docker-compose.yml restart
+#   停止：       docker compose -f deploy/docker-compose.yml down
+#
+# 网络设计（对应《内网穿透架构与迁移指南》的「只绑回环」原则）：
+#   端口只发布到宿主的 127.0.0.1（`127.0.0.1:8089:8089` 这种写法）→ 局域网访问不到，
+#   宿主的 cloudflared（已在跑）可以访问：
+#       127.0.0.1:8089  → 网页端（@noname/fs，容器内监听 0.0.0.0 才能被端口转发进来）
+#       127.0.0.1:8082  → 大厅（@noname/server，WebSocket）
+#
+#   ⚠️ 2026-10-07 实测：**不要用 `network_mode: host`** —— Docker Desktop(Windows) 上它并不共享宿主网络，
+#   容器里服务起得来但宿主连不上（端口全是 ECONNREFUSED）。用端口映射 + 容器内监听 0.0.0.0 才可靠。
+#
+# 网页端产物：
+#   容器不自己构建前端（那要把 1.25GB 的 dist 打进镜像）。约定：
+#       宿主执行  cd .. && pnpm build      # 产出 noname/dist
+#       然后重启容器即可生效（dist 以只读方式挂载）
+# ==============================================================================
+services:
+    noname:
+        build:
+            context: ..
+            dockerfile: deploy/Dockerfile.online
+        image: noname-online:latest
+        container_name: noname_online
+        ports:
+            # 只绑回环：局域网访问不到；隧道/反代在本机所以够用
+            - "127.0.0.1:8089:8089"
+            - "127.0.0.1:8082:8082"
+        volumes:
+            - ../dist:/app/dist:ro
+        environment:
+            TZ: Asia/Shanghai
+            NONAME_DIST: /app/dist
+        restart: unless-stopped
