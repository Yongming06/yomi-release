diff --git a/deploy/start.sh b/deploy/start.sh
new file mode 100644
index 0000000..426e7dc
--- /dev/null
+++ b/deploy/start.sh
@@ -0,0 +1,42 @@
+#!/bin/sh
+# ==============================================================================
+# 容器入口：同时拉起「网页端静态服务」与「大厅 WS 服务」
+#   · 任一进程退出 → 容器结束（交给 compose 的 restart: unless-stopped 拉起）
+#   · 收到 TERM/INT（docker stop / compose down）→ 两个子进程一起收尸
+# 说明：命令部分保持纯 ASCII；容器内是 UTF-8 的 /bin/sh，中文注释安全。
+# （纯 ASCII 的坑只在 Windows 的 .bat / cmd.exe 上，见《内网穿透架构与迁移指南》§7.5）
+#
+# 监听地址：
+#   · 网页端必须绑 0.0.0.0 —— Docker 的端口转发连的是**容器 IP**，
+#     容器内只绑 127.0.0.1 的话宿主映射不进来（2026-10-07 实测踩过）。
+#     暴露面由 compose 控制：端口只发布到宿主 127.0.0.1，局域网访问不到。
+#   · 大厅 (@noname/server) 本身就绑所有接口。
+# ==============================================================================
+set -e
+cd /app
+
+TSX=/app/node_modules/.bin/tsx
+DIST=${NONAME_DIST:-/app/dist}
+
+echo "[noname] web  @noname/fs     -> 0.0.0.0:8089 (dirname=$DIST)"
+"$TSX" fs/src/entry.ts --server --host 0.0.0.0 --dirname="$DIST" &
+FS_PID=$!
+
+echo "[noname] hall @noname/server -> 0.0.0.0:8082"
+"$TSX" server/src/cli.ts &
+LOBBY_PID=$!
+
+stop() {
+    kill "$FS_PID" "$LOBBY_PID" 2>/dev/null || true
+    wait 2>/dev/null || true
+    exit 0
+}
+trap stop TERM INT
+
+# dash 没有 wait -n，用轮询代替：两个都活着就继续等
+while kill -0 "$FS_PID" 2>/dev/null && kill -0 "$LOBBY_PID" 2>/dev/null; do
+    sleep 5
+done
+
+echo "[noname] a child process exited, stopping container"
+stop
