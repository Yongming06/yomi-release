 	const errLines = async () => (await readText(ERRLOG)).split("\n").length;
+	/** 取错误日志从第 baseLine 行起的**新增原文**，并标注已知的上游噪音 */
+	async function newErrText(baseLine) {
+		const all = (await readText(ERRLOG)).split("\n");
+		const fresh = all.slice(Math.max(0, baseLine)).join("\n").trim();
+		if (!fresh) return "";
+		const known = ["when parsing die audio"]; // 本体：李典皮肤名 lidian 不是角色 → 音频回退默认，无影响
+		const tag = known.some(k => fresh.includes(k)) ? "（⚠️本体已知噪音，非我方问题）" : "（❗可能是我们的 bug）";
+		return tag + "\n" + fresh.split("\n").slice(0, 40).join("\n");
+	}
 
 	/* ---------- 批次状态（跨整页重载存活） ---------- */
 	const loadState = () => {
@@ -321,6 +330,8 @@ import { lib, game, ui, get, ai, _status } from "noname";
