 				info.popup = false;
 			}
 		}
+		// ★ 本项目自制技能自动静默护栏（2026-10-04 v0.31）：
+		//   凡 `yomi_` 前缀、带 trigger 且 forced 的技能，一律补 `silent` ——
+		//   彻底杜绝多个同优先级技能同时触发时弹「选择下一个触发的技能」
+		//   （arrangeTrigger 见 library/element/content.ts:4017；silent 会让下面的 _priority +1，
+		//   同优先级组内也会被优先执行，因此不会再询问顺序）。
+		//   ⚠️ 可选（非 forced）技能**绝不能**自动加 silent —— 上面的 `if (info.silent)`
+		//   会把它强制变成 forced（技能不再询问玩家是否发动）。
+		if (typeof skillId === "string" && skillId.startsWith("yomi_") && info.trigger && info.forced === true && !("silent" in info)) {
+			info.silent = true;
+			// silent 默认会同时关掉技能名弹窗；这里显式补 popup，保留可见技能原有的视觉表现
+			if (!("popup" in info)) {
+				info.popup = !(info.sub || info.charlotte);
+			}
+		}
 		if (!("_priority" in info)) {
 			let priority = 0;
 			if (info.priority) {
