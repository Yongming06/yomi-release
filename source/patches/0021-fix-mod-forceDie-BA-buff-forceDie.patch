@@ -2605,6 +2605,8 @@ const skillsBatch02 = {
 		forced: true,
 		popup: false,
 		nopop: true,
+		// ★ forceDie：否则「持有者自己阵亡 → 清护甲」这一支不会被引擎调用（isDead 拦，2026-10-08 复查指出）
+		forceDie: true,
 		trigger: { player: "phaseBegin", global: "dieAfter" },
 		filter(event, player, triggername) {
 			if (!(player.storage.yomi_ba_qundun_list || []).length) return false;
@@ -2712,6 +2714,8 @@ const skillsBatch02 = {
 		forced: true,
 		popup: false,
 		nopop: true,
