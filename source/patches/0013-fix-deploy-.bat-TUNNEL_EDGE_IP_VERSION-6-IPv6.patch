---
 deploy/cloudflared-http2.bat | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/deploy/cloudflared-http2.bat b/deploy/cloudflared-http2.bat
index 9135d2c..3cdf0f2 100644
--- a/deploy/cloudflared-http2.bat
+++ b/deploy/cloudflared-http2.bat
@@ -20,10 +20,12 @@ rem ============================================================================
 chcp 65001 >nul
 setlocal
 set "EXE=C:\Program Files (x86)\cloudflared\cloudflared.exe"
-rem Force IPv6 to the Cloudflare tunnel edge: measured 2026-10-07, IPv4 lands on
-rem Los Angeles (285-342 ms RTT, ~1-2 KB/s) while IPv6 reaches a nearby edge (30 ms).
-rem This overrides the machine-level TUNNEL_EDGE_IP_VERSION for this process only.
-set "TUNNEL_EDGE_IP_VERSION=6"
+rem NOTE (2026-10-07): forcing TUNNEL_EDGE_IP_VERSION=6 was TRIED AND FAILED here -
+rem this machine has no global IPv6 address, so cloudflared exits with
+rem "there are no free edge addresses left to resolve to".
+rem IPv4 lands on Los Angeles (~300 ms RTT, only 1-2 KB/s) and cannot be improved by config.
+rem => For real gameplay use ZeroTier instead (see the ZeroTier friend guide);
+rem    keep this tunnel only as a slow remote fallback.
 set "LOG=%~dp0..\..\_worklog\cloudflared-http2.log"
 set "TOKEN=%CLOUDFLARED_TUNNEL_TOKEN%"
 if not defined TOKEN if exist "%~dp0..\..\.cloudflare-tunnel-token" set /p TOKEN=<"%~dp0..\..\.cloudflare-tunnel-token"
